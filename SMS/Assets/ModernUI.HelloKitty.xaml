<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sui="http://codeflexsystems.com/SmartUI">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/CodeflexSystems.SmartUI;component/Assets/ModernUI.Light.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Color x:Key="AccentColor">#f472d0</Color>

    <Rectangle x:Key="WindowBackgroundContent" x:Shared="false" Margin="32">
        <Rectangle.Fill>
            <ImageBrush Opacity=".1" ImageSource="/Resources/background.kitty.png" Stretch="None" AlignmentX="Right" AlignmentY="Bottom" />
        </Rectangle.Fill>
    </Rectangle>

</ResourceDictionary>