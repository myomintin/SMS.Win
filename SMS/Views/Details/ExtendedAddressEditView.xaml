<sui:SimpleWindow x:Class="CodeflexSystems.SMS.Views.ExtendedAddressEditView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sui="http://codeflexsystems.com/SmartUI"
        xmlns:views="clr-namespace:CodeflexSystems.SMS.Views"
        xmlns:models="clr-namespace:CodeflexSystems.SMS.Models"
        Width="415" Height="450" ResizeMode="NoResize" ShowInTaskbar="False"
        Title="{Binding ViewName}">
    <DockPanel Style="{StaticResource DefaultDockPanelWithTabControl}">
        <StackPanel Style="{StaticResource DefaultStackPanelButtonBarWithTabControl}">
            <Button Name="OKButton" Style="{StaticResource DefaultOKButton}"/>
            <Button Name="CancelButton" Style="{StaticResource DefaultCancelButton}"/>
        </StackPanel>

        <TabControl>
            <TabItem Header="Address">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Column="0" Grid.Row="0" Content="Line _1" Style="{StaticResource DefaultLabel}"
                           Target="{Binding ElementName=Line1TextBox, Mode=OneWay}"/>
                    <sui:AutoSelectTextBox Name="Line1TextBox" Grid.Column="1" Grid.Row="0" Style="{StaticResource DefaultAutoSelectTextBoxMW200}"
                             Text="{Binding Line1, NotifyOnValidationError=True, ValidatesOnExceptions=True}"
                             Height="45" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

                    <Label Grid.Column="0" Grid.Row="1" Content="Line _2" Style="{StaticResource DefaultLabel}"
                           Target="{Binding ElementName=Line2TextBox, Mode=OneWay}"/>
                    <sui:AutoSelectTextBox Name="Line2TextBox" Grid.Column="1" Grid.Row="1" Style="{StaticResource DefaultAutoSelectTextBoxMW200}"
                             Text="{Binding Line2, NotifyOnValidationError=True, ValidatesOnExceptions=True}"/>

                    <Label Grid.Column="0" Grid.Row="2" Content="_ZipCode" Style="{StaticResource DefaultLabel}"
                           Target="{Binding ElementName=ZipCodeTextBox, Mode=OneWay}"/>
                    <sui:AutoSelectTextBox Name="ZipCodeTextBox" Grid.Column="1" Grid.Row="2" Style="{StaticResource DefaultAutoSelectTextBoxMW200}"
                             Text="{Binding ZipCode, NotifyOnValidationError=True, ValidatesOnExceptions=True}"/>

                    <Label Grid.Column="0" Grid.Row="3" Content="_City" Style="{StaticResource DefaultLabel}"
                           Target="{Binding ElementName=CityTextBox, Mode=OneWay}"/>
                    <sui:AutoSelectTextBox Name="CityTextBox" Grid.Column="1" Grid.Row="3" Style="{StaticResource DefaultAutoSelectTextBoxMW200}"
                             Text="{Binding City, NotifyOnValidationError=True, ValidatesOnExceptions=True}"/>

                    <Label Grid.Column="0" Grid.Row="4" Content="_Township" Style="{StaticResource DefaultLabel}"
                           Target="{Binding ElementName=TownshipTextBox, Mode=OneWay}"/>
                    <sui:AutoSelectTextBox Name="TownshipTextBox" Grid.Column="1" Grid.Row="4" Style="{StaticResource DefaultAutoSelectTextBoxMW200}"
                             Text="{Binding Township, NotifyOnValidationError=True, ValidatesOnExceptions=True}"/>

                    <Label Grid.Column="0" Grid.Row="5" Content="_State" Style="{StaticResource DefaultLabel}"
                           Target="{Binding ElementName=StateTextBox, Mode=OneWay}"/>
                    <sui:AutoSelectTextBox Name="StateTextBox" Grid.Column="1" Grid.Row="5" Style="{StaticResource DefaultAutoSelectTextBoxMW200}"
                             Text="{Binding State, NotifyOnValidationError=True, ValidatesOnExceptions=True}"/>

                    <Label Grid.Column="0" Grid.Row="6" Content="Count_ry" Style="{StaticResource DefaultLabel}"
                           Target="{Binding ElementName=CountryComboBox, Mode=OneWay}"/>
                    <ComboBox Name="CountryComboBox" Grid.Column="1" Grid.Row="6" Style="{StaticResource DefaultComboBoxMW200}"
                              SelectedItem="{Binding Country, Mode=TwoWay}" ItemsSource="{Binding Countries}"/>

                    <Label Grid.Column="0" Grid.Row="7" Content="Created Date" Style="{StaticResource DefaultLabel}"/>
                    <TextBlock Name="cdtb" Grid.Column="1" Grid.Row="7" Style="{StaticResource DefaultTextBlock}" 
                               Text="{Binding CreatedDateLT, StringFormat={StaticResource DateTimePattern}}"
                               Visibility="{Binding Path=IsNew, Converter={StaticResource InverseBooleanToHiddenConverter}}"/>

                    <Label Grid.Column="0" Grid.Row="8" Content="Created By" Style="{StaticResource DefaultLabel}"/>
                    <TextBlock Grid.Column="1" Grid.Row="8" Style="{StaticResource DefaultTextBlock}" 
                               Text="{Binding CreatedBy}"
                               Visibility="{Binding Visibility, ElementName=cdtb}"/>

                    <Label Grid.Column="0" Grid.Row="9" Content="Modified Date" Style="{StaticResource DefaultLabel}"/>
                    <TextBlock Grid.Column="1" Grid.Row="9" Style="{StaticResource DefaultTextBlock}" 
                               Text="{Binding ModifiedDateLT, StringFormat={StaticResource DateTimePattern}}"
                               Visibility="{Binding Visibility, ElementName=cdtb}"/>

                    <Label Grid.Column="0" Grid.Row="10" Content="Modified By" Style="{StaticResource DefaultLabel}"/>
                    <TextBlock Grid.Column="1" Grid.Row="10" Style="{StaticResource DefaultTextBlock}" 
                               Text="{Binding ModifiedBy}"
                               Visibility="{Binding Visibility, ElementName=cdtb}"/>
                </Grid>
            </TabItem>
            <TabItem Header="Students"
                     Visibility="{Binding Students.Count, Converter={StaticResource CountToVisibilityConverter}}">
                <ListBox Style="{StaticResource DefaultListBox}"
                         ItemsSource="{Binding Students}"
                         ItemTemplate="{StaticResource StudentListBoxItemTemplate}"/>
            </TabItem>
            <TabItem Header="Guardians"
                     Visibility="{Binding Guardians.Count, Converter={StaticResource CountToVisibilityConverter}}">
                <ListBox Style="{StaticResource DefaultListBox}"
                         ItemsSource="{Binding Guardians}"
                         DisplayMemberPath="TitleGuardianName"/>
            </TabItem>
            <TabItem Header="Schools"
                     Visibility="{Binding Schools.Count, Converter={StaticResource CountToVisibilityConverter}}">
                <ListBox Style="{StaticResource DefaultListBox}"
                         ItemsSource="{Binding Schools}"
                         DisplayMemberPath="SchoolName"/>
            </TabItem>
        </TabControl>
    </DockPanel>
</sui:SimpleWindow>
