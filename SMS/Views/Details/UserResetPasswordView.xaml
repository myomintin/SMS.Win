<sui:SimpleWindow x:Class="CodeflexSystems.SMS.Views.UserResetPasswordView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sui="http://codeflexsystems.com/SmartUI"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False"
        Title="{Binding ViewName}">
    <DockPanel Style="{StaticResource DefaultDockPanel}"
               FocusManager.FocusedElement="{Binding ElementName=PasswordTextBox}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Label Grid.Column="0" Grid.Row="0" Content="_Password" Style="{StaticResource DefaultLabel}"
                   Target="{Binding ElementName=PasswordTextBox, Mode=OneWay}"/>
            <PasswordBox Name="PasswordTextBox" Grid.Column="1" Grid.Row="0"  Style="{StaticResource DefaultPasswordBox}"
                         LostFocus="PasswordTextBox_LostFocus"/>

            <Label Grid.Column="0" Grid.Row="1" Content="_Confirm Password" Style="{StaticResource DefaultLabel}"
                   Target="{Binding ElementName=ConfirmPasswordTextBox, Mode=OneWay}"/>
            <PasswordBox Name="ConfirmPasswordTextBox" Grid.Column="1" Grid.Row="1" Style="{StaticResource DefaultPasswordBox}"
                         LostFocus="ConfirmPasswordTextBox_LostFocus"/>

            <Grid Grid.Column="1" Grid.Row="2" Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Button Name="OKButton" Grid.Column="0" Style="{StaticResource DefaultOKButton}" HorizontalAlignment="Left"/>
                <Button Name="CancelButton" Grid.Column="1" Style="{StaticResource DefaultCancelButton}" HorizontalAlignment="Right"/>
            </Grid>
        </Grid>
    </DockPanel>
</sui:SimpleWindow>
