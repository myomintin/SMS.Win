<sui:SimpleWindow x:Class="CodeflexSystems.SMS.Views.AddCountriesView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sui="http://codeflexsystems.com/SmartUI"
        Title="Country List" Height="500" Width="700" ResizeMode="NoResize" ShowInTaskbar="False">
    <DockPanel Style="{StaticResource DefaultDockPanel}">
        <StackPanel Style="{StaticResource DefaultStackPanelButtonBar}">
            <Button Name="OKButton" Style="{StaticResource DefaultOKButton}" Click="OKButton_Click"/>
            <Button Name="CancelButton" Style="{StaticResource DefaultCancelButton}"/>
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Select the countries to add." Margin="0,0,0,5"/>
            <sui:CheckListBox Grid.Row="1" ItemsSource="{Binding}" Delimiter=","
                              DisplayMemberPath="CountryName"
                              SelectedMemberPath="IsSelected"
                              ValueMemberPath="CountryCode"/>
        </Grid>
    </DockPanel>
</sui:SimpleWindow>
