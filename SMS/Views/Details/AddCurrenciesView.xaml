<sui:SimpleWindow x:Class="CodeflexSystems.SMS.Views.AddCurrenciesView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sui="http://codeflexsystems.com/SmartUI"
        Title="Currencies List" Height="400" Width="500" ResizeMode="NoResize" ShowInTaskbar="False">
    <DockPanel Style="{StaticResource DefaultDockPanel}">
        <StackPanel Style="{StaticResource DefaultStackPanelButtonBar}">
            <Button Name="OKButton" Style="{StaticResource DefaultOKButton}" Click="OKButton_Click"/>
            <Button Name="CancelButton" Style="{StaticResource DefaultCancelButton}"/>
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Select the currencies to add." Margin="0,0,0,5"/>
            <sui:CheckListBox Grid.Row="1" ItemsSource="{Binding}" Delimiter=","
                              DisplayMemberPath="CurrencyCodeName"
                              SelectedMemberPath="IsSelected"
                              ValueMemberPath="CurrencyCode"/>
        </Grid>
    </DockPanel>
</sui:SimpleWindow>
