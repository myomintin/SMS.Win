<sui:SimpleWindow x:Class="CodeflexSystems.SMS.Views.SchoolEditView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sui="http://codeflexsystems.com/SmartUI"
        xmlns:views="clr-namespace:CodeflexSystems.SMS.Views"
        Width="700" Height="500" ResizeMode="NoResize" ShowInTaskbar="False"
        Title="{Binding ViewName}">
    <DockPanel Style="{StaticResource DefaultDockPanelWithTabControl}">
        <StackPanel Style="{StaticResource DefaultStackPanelButtonBarWithTabControl}">
            <Button Name="OKButton" Style="{StaticResource DefaultOKButton}"/>
            <Button Name="CancelButton" Style="{StaticResource DefaultCancelButton}"/>
        </StackPanel>

        <TabControl>
            <TabItem Header="School">
                <Grid Width="380" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Column="0" Grid.Row="0" Content="School _Name" Style="{StaticResource DefaultLabel}"
                           Target="{Binding ElementName=SchoolNameTextBox, Mode=OneWay}"/>
                    <sui:AutoSelectTextBox Name="SchoolNameTextBox" Grid.Column="1" Grid.Row="0" Style="{StaticResource DefaultAutoSelectTextBoxMW200}"
                             Text="{Binding SchoolName, NotifyOnValidationError=True, ValidatesOnExceptions=True}"/>

                    <Label Grid.Column="0" Grid.Row="1" Content="_Motto" Style="{StaticResource DefaultLabel}"
                           Target="{Binding ElementName=MottoTextBox, Mode=OneWay}"/>
                    <sui:AutoSelectTextBox Name="MottoTextBox" Grid.Column="1" Grid.Row="1" Style="{StaticResource DefaultAutoSelectTextBoxMW200}"
                             Text="{Binding Motto, NotifyOnValidationError=True, ValidatesOnExceptions=True}"
                             Height="52" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

                    <Label Grid.Column="0" Grid.Row="2" Content="D_escription" Style="{StaticResource DefaultLabel}"
                           Target="{Binding ElementName=DescriptionTextBox, Mode=OneWay}"/>
                    <sui:AutoSelectTextBox Name="DescriptionTextBox" Grid.Column="1" Grid.Row="2" Style="{StaticResource DefaultAutoSelectTextBoxMW200}"
                             Text="{Binding Description, NotifyOnValidationError=True, ValidatesOnExceptions=True}"
                             Height="52" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

                    <CheckBox Grid.Column="1" Grid.Row="3" IsChecked="{Binding Active}"
                              Content="Active" Style="{StaticResource DefaultCheckBox}"/>

                    <Label Grid.Column="0" Grid.Row="4" Content="Created Date" Style="{StaticResource DefaultLabel}"/>
                    <TextBlock Name="cdtb" Grid.Column="1" Grid.Row="4" Style="{StaticResource DefaultTextBlock}" 
                               Text="{Binding CreatedDateLT, StringFormat={StaticResource DateTimePattern}}"
                               Visibility="{Binding Path=IsNew, Converter={StaticResource InverseBooleanToHiddenConverter}}"/>

                    <Label Grid.Column="0" Grid.Row="5" Content="Created By" Style="{StaticResource DefaultLabel}"/>
                    <TextBlock Grid.Column="1" Grid.Row="5" Style="{StaticResource DefaultTextBlock}" 
                               Text="{Binding CreatedBy}"
                               Visibility="{Binding Visibility, ElementName=cdtb}"/>

                    <Label Grid.Column="0" Grid.Row="6" Content="Modified Date" Style="{StaticResource DefaultLabel}"/>
                    <TextBlock Grid.Column="1" Grid.Row="6" Style="{StaticResource DefaultTextBlock}" 
                               Text="{Binding ModifiedDateLT, StringFormat={StaticResource DateTimePattern}}"
                               Visibility="{Binding Visibility, ElementName=cdtb}"/>

                    <Label Grid.Column="0" Grid.Row="7" Content="Modified By" Style="{StaticResource DefaultLabel}"/>
                    <TextBlock Grid.Column="1" Grid.Row="7" Style="{StaticResource DefaultTextBlock}" 
                               Text="{Binding ModifiedBy}"
                               Visibility="{Binding Visibility, ElementName=cdtb}"/>
                </Grid>
            </TabItem>
            <TabItem Header="Address">
                <views:LocationAddressView Width="400" HorizontalAlignment="Left"/>
            </TabItem>
            <TabItem Header="Emails">
                <views:EmailListView/>
            </TabItem>
            <TabItem Header="Phones">
                <views:PhoneListView/>
            </TabItem>
        </TabControl>
    </DockPanel>
</sui:SimpleWindow>
