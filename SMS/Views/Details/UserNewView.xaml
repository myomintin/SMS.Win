<sui:SimpleWindow x:Class="CodeflexSystems.SMS.Views.UserNewView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sui="http://codeflexsystems.com/SmartUI"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False"
        Title="{Binding ViewName}">
    <DockPanel Style="{StaticResource DefaultDockPanel}"
               FocusManager.FocusedElement="{Binding ElementName=UserNameTextBox}">
        <StackPanel Style="{StaticResource DefaultStackPanelButtonBar}">
            <Button Name="OKButton" Style="{StaticResource DefaultOKButton}"/>
            <Button Name="CancelButton" Style="{StaticResource DefaultCancelButton}"/>
        </StackPanel>
        
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Label Grid.Column="0" Grid.Row="0" Content="User _Name" Style="{StaticResource DefaultLabel}"
                   Target="{Binding ElementName=UserNameTextBox, Mode=OneWay}"/>
            <sui:AutoSelectTextBox Name="UserNameTextBox" Grid.Column="1" Grid.Row="0" Style="{StaticResource DefaultAutoSelectTextBoxMW200}"
                     Text="{Binding UserName, NotifyOnValidationError=True, ValidatesOnExceptions=True}"/>

            <Label Grid.Column="0" Grid.Row="1" Content="_Full Name" Style="{StaticResource DefaultLabel}"
                   Target="{Binding ElementName=FullNameTextBox, Mode=OneWay}"/>
            <sui:AutoSelectTextBox Name="FullNameTextBox" Grid.Column="1" Grid.Row="1" Style="{StaticResource DefaultAutoSelectTextBoxMW200}"
                     Text="{Binding FullName, NotifyOnValidationError=True, ValidatesOnExceptions=True}"/>

            <Label Grid.Column="0" Grid.Row="2" Content="D_escription" Style="{StaticResource DefaultLabel}"
                   Target="{Binding ElementName=DescriptionTextBox, Mode=OneWay}"/>
            <sui:AutoSelectTextBox Name="DescriptionTextBox" Grid.Column="1" Grid.Row="2" Style="{StaticResource DefaultAutoSelectTextBoxMW200}"
                     Text="{Binding Description, NotifyOnValidationError=True, ValidatesOnExceptions=True}"
                     Height="52" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

            <CheckBox Grid.Column="1" Grid.Row="5" IsChecked="{Binding Disabled}" Content="Disabled"
                      IsEnabled="{Binding IsNotLogonUser, Mode=OneWay}" Style="{StaticResource DefaultCheckBox}"/>

            <Label Grid.Column="0" Grid.Row="3" Content="_Password" Style="{StaticResource DefaultLabel}"
                   Target="{Binding ElementName=PasswordTextBox, Mode=OneWay}"/>
            <PasswordBox Name="PasswordTextBox" Grid.Column="1" Grid.Row="3"  Style="{StaticResource DefaultPasswordBox}"
                         LostFocus="PasswordTextBox_LostFocus"/>

            <Label Grid.Column="0" Grid.Row="4" Content="_Confirm Password" Style="{StaticResource DefaultLabel}"
                   Target="{Binding ElementName=ConfirmPasswordTextBox, Mode=OneWay}"/>
            <PasswordBox Name="ConfirmPasswordTextBox" Grid.Column="1" Grid.Row="4" Style="{StaticResource DefaultPasswordBox}"
                         LostFocus="ConfirmPasswordTextBox_LostFocus"/>
        </Grid>
    </DockPanel>
</sui:SimpleWindow>
