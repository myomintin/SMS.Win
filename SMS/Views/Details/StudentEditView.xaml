<sui:SimpleWindow x:Class="CodeflexSystems.SMS.Views.StudentEditView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sui="http://codeflexsystems.com/SmartUI"
        xmlns:controls="clr-namespace:CodeflexSystems.SMS.Controls"
        xmlns:views="clr-namespace:CodeflexSystems.SMS.Views"
        Width="700" Height="600" ResizeMode="NoResize" ShowInTaskbar="False"
        Title="{Binding ViewName}">
    <DockPanel Style="{StaticResource DefaultDockPanelWithTabControl}">
        <StackPanel Style="{StaticResource DefaultStackPanelButtonBarWithTabControl}">
            <Button Name="OKButton" Style="{StaticResource DefaultOKButton}"/>
            <Button Name="CancelButton" Style="{StaticResource DefaultCancelButton}"/>
        </StackPanel>

        <TabControl>
            <TabItem Header="Student">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="{StaticResource DefaultColumnGap}"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Column="0" Grid.Row="0" Content="_Id" Style="{StaticResource DefaultLabel}"
                           Target="{Binding ElementName=IdTextBox, Mode=OneWay}"/>
                    <sui:AutoSelectTextBox Name="IdTextBox" Grid.Column="1" Grid.Row="0" Style="{StaticResource DefaultAutoSelectTextBoxMW200}"
                             Text="{Binding Id, NotifyOnValidationError=True, ValidatesOnExceptions=True}"/>

                    <Label Grid.Column="0" Grid.Row="1" Content="_Title" Style="{StaticResource DefaultLabel}"
                           Target="{Binding ElementName=TitleTextBox, Mode=OneWay}"/>
                    <sui:AutoSelectTextBox Name="TitleTextBox" Grid.Column="1" Grid.Row="1" Style="{StaticResource DefaultAutoSelectTextBoxMW200}"
                             Text="{Binding Title, NotifyOnValidationError=True, ValidatesOnExceptions=True}"/>

                    <Label Grid.Column="0" Grid.Row="2" Content="Student _Name" Style="{StaticResource DefaultLabel}"
                           Target="{Binding ElementName=StudentNameTextBox, Mode=OneWay}"/>
                    <sui:AutoSelectTextBox Name="StudentNameTextBox" Grid.Column="1" Grid.Row="2" Style="{StaticResource DefaultAutoSelectTextBoxMW200}"
                             Text="{Binding StudentName, NotifyOnValidationError=True, ValidatesOnExceptions=True}"/>

                    <Label Grid.Column="0" Grid.Row="3" Content="_Other Name" Style="{StaticResource DefaultLabel}"
                           Target="{Binding ElementName=OtherNameTextBox, Mode=OneWay}"/>
                    <sui:AutoSelectTextBox Name="OtherNameTextBox" Grid.Column="1" Grid.Row="3" Style="{StaticResource DefaultAutoSelectTextBoxMW200}"
                             Text="{Binding OtherName, NotifyOnValidationError=True, ValidatesOnExceptions=True}"/>

                    <Label Grid.Column="0" Grid.Row="4" Content="_Gender" Style="{StaticResource DefaultLabel}"
                           Target="{Binding ElementName=MaleRadioButton, Mode=OneWay}"/>
                    <StackPanel Grid.Column="1" Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Left">
                        <RadioButton Content="Male" Name="MaleRadioButton" GroupName="Gender"
                                     Style="{StaticResource DefaultRadioButton}"
                                     Checked="GenderChecked" IsChecked="True"/>
                        <RadioButton Content="Female" Name="FemaleRadioButton" GroupName="Gender"
                                     Style="{StaticResource DefaultRadioButton}"
                                     Checked="GenderChecked" Margin="10,0,0,0"/>
                    </StackPanel>

                    <Label Grid.Column="0" Grid.Row="5" Content="_Birth Date" Style="{StaticResource DefaultLabel}"
                           Target="{Binding ElementName=BirthDatePicker, Mode=OneWay}"/>
                    <sui:DateTimePicker Name="BirthDatePicker" Grid.Column="1" Grid.Row="5" Style="{StaticResource DefaultDateTimePickerMW200}"
                                        Value="{Binding BirthDate}"/>

                    <Label Grid.Column="0" Grid.Row="6" Content="Birth _Country" Style="{StaticResource DefaultLabel}"
                           Target="{Binding ElementName=BirthCountryComboBox, Mode=OneWay}"/>
                    <ComboBox Name="BirthCountryComboBox" Grid.Column="1" Grid.Row="6" Style="{StaticResource DefaultComboBoxMW200}"
                              SelectedItem="{Binding BirthCountry, Mode=TwoWay}" ItemsSource="{Binding Countries}"/>

                    <Label Grid.Column="0" Grid.Row="7" Content="Nationalit_y" Style="{StaticResource DefaultLabel}"
                           Target="{Binding ElementName=NationalityTextBox, Mode=OneWay}"/>
                    <sui:AutoSelectTextBox Name="NationalityTextBox" Grid.Column="1" Grid.Row="7" Style="{StaticResource DefaultAutoSelectTextBoxMW200}"
                             Text="{Binding Nationality, NotifyOnValidationError=True, ValidatesOnExceptions=True}"/>

                    <Label Grid.Column="0" Grid.Row="8" Content="N_IRC No." Style="{StaticResource DefaultLabel}"
                           Target="{Binding ElementName=NIRCTextBox, Mode=OneWay}"/>
                    <sui:AutoSelectTextBox Name="NIRCTextBox" Grid.Column="1" Grid.Row="8" Style="{StaticResource DefaultAutoSelectTextBoxMW200}"
                             Text="{Binding NIRC, NotifyOnValidationError=True, ValidatesOnExceptions=True}"/>

                    <Label Grid.Column="0" Grid.Row="9" Content="_Religion" Style="{StaticResource DefaultLabel}"
                           Target="{Binding ElementName=ReligionComboBox, Mode=OneWay}"/>
                    <ComboBox Name="ReligionComboBox" Grid.Column="1" Grid.Row="9" Style="{StaticResource DefaultComboBoxMW200}"
                              SelectedItem="{Binding Religion, Mode=TwoWay}" ItemsSource="{Binding Religions}"/>

                    <Label Grid.Column="3" Grid.Row="0" Content="Photo" Style="{StaticResource DefaultLabel}"/>
                    <controls:ImageViewer x:Name="PhotoViewer" Grid.Column="4" Grid.Row="0" Grid.RowSpan="4"
                                          Source="{Binding Photo, Mode=TwoWay}" DefaultImageValue="{Binding Gender, Mode=OneWay}"
                                          Style="{StaticResource DefaultImageViewer}">
                        <controls:ImageViewer.DefaultImageList>
                            <controls:ImageDictionary>
                                <Image x:Key="True" Source="/Resources/gender.male.png"/>
                                <Image x:Key="False" Source="/Resources/gender.female.png"/>
                            </controls:ImageDictionary>
                        </controls:ImageViewer.DefaultImageList>
                    </controls:ImageViewer>

                    <Label Grid.Column="3" Grid.Row="4" Content="_Passport" Style="{StaticResource DefaultLabel}"
                           Target="{Binding ElementName=PassportTextBox, Mode=OneWay}"/>
                    <sui:AutoSelectTextBox Name="PassportTextBox" Grid.Column="4" Grid.Row="4" Style="{StaticResource DefaultAutoSelectTextBoxMW200}"
                             Text="{Binding Passport, NotifyOnValidationError=True, ValidatesOnExceptions=True}"/>

                    <Label Grid.Column="3" Grid.Row="5" Content="_Visa" Style="{StaticResource DefaultLabel}"
                           Target="{Binding ElementName=VisaTextBox, Mode=OneWay}"/>
                    <sui:AutoSelectTextBox Name="VisaTextBox" Grid.Column="4" Grid.Row="5" Style="{StaticResource DefaultAutoSelectTextBoxMW200}"
                             Text="{Binding Visa, NotifyOnValidationError=True, ValidatesOnExceptions=True}"/>

                    <Label Grid.Column="3" Grid.Row="6" Content="D_escription" Style="{StaticResource DefaultLabel}"
                           Target="{Binding ElementName=DescriptionTextBox, Mode=OneWay}"/>
                    <sui:AutoSelectTextBox Name="DescriptionTextBox" Grid.Column="4" Grid.Row="6" Style="{StaticResource DefaultAutoSelectTextBoxMW200}"
                            Text="{Binding Description, NotifyOnValidationError=True, ValidatesOnExceptions=True}"
                            Grid.RowSpan="2" TextWrapping="Wrap" Height="52" VerticalScrollBarVisibility="Auto"/>

                    <Label Grid.Column="3" Grid.Row="8" Content="Created Date" Style="{StaticResource DefaultLabel}"/>
                    <TextBlock Name="cdtb" Grid.Column="4" Grid.Row="8" Style="{StaticResource DefaultTextBlock}" 
                               Text="{Binding CreatedDateLT, StringFormat={StaticResource DateTimePattern}}"
                               Visibility="{Binding Path=IsNew, Converter={StaticResource InverseBooleanToHiddenConverter}}"/>

                    <Label Grid.Column="3" Grid.Row="9" Content="Created By" Style="{StaticResource DefaultLabel}"/>
                    <TextBlock Grid.Column="4" Grid.Row="9" Style="{StaticResource DefaultTextBlock}" 
                               Text="{Binding CreatedBy}"
                               Visibility="{Binding Visibility, ElementName=cdtb}"/>

                    <Label Grid.Column="3" Grid.Row="10" Content="Modified Date" Style="{StaticResource DefaultLabel}"/>
                    <TextBlock Grid.Column="4" Grid.Row="10" Style="{StaticResource DefaultTextBlock}" 
                               Text="{Binding ModifiedDateLT, StringFormat={StaticResource DateTimePattern}}"
                               Visibility="{Binding Visibility, ElementName=cdtb}"/>

                    <Label Grid.Column="3" Grid.Row="11" Content="Modified By" Style="{StaticResource DefaultLabel}"/>
                    <TextBlock Grid.Column="4" Grid.Row="11" Style="{StaticResource DefaultTextBlock}" 
                               Text="{Binding ModifiedBy}"
                               Visibility="{Binding Visibility, ElementName=cdtb}"/>
                </Grid>
            </TabItem>
            <TabItem Header="Educations">
                <views:StudentEducationListView/>
            </TabItem>
            <TabItem Header="Guardians">
                <views:PersonGuardianListView/>
            </TabItem>
            <TabItem Header="Addresses">
                <views:PersonAddressListView/>
            </TabItem>
            <TabItem Header="Emails">
                <views:EmailListView/>
            </TabItem>
            <TabItem Header="Phones">
                <views:PhoneListView/>
            </TabItem>
        </TabControl>
    </DockPanel>
</sui:SimpleWindow>
