<sui:SimpleWindow x:Class="CodeflexSystems.SMS.Views.StudentEducationEditView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sui="http://codeflexsystems.com/SmartUI"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False"
        Title="{Binding ViewName}">
    <DockPanel Style="{StaticResource DefaultDockPanel}"
               FocusManager.FocusedElement="{Binding ElementName=ActiveCheckBox}">
        <StackPanel Style="{StaticResource DefaultStackPanelButtonBar}">
            <Button Name="OKButton" Style="{StaticResource DefaultOKButton}"/>
            <Button Name="CancelButton" Style="{StaticResource DefaultCancelButton}"/>
        </StackPanel>

        <Grid Grid.IsSharedSizeScope="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition SharedSizeGroup="TextBlockColumn"/>
                <ColumnDefinition Width="{StaticResource DefaultColumnGap}"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition SharedSizeGroup="TextBlockColumn"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Label Grid.Column="0" Grid.Row="0" Content="School" Style="{StaticResource DefaultLabel}"/>
            <TextBlock Grid.Column="1" Grid.Row="0" Style="{StaticResource DefaultTextBlock}"
                       Text="{Binding School}"/>

            <Label Grid.Column="0" Grid.Row="1" Content="Academic Year" Style="{StaticResource DefaultLabel}"/>
            <TextBlock Grid.Column="1" Grid.Row="1" Style="{StaticResource DefaultTextBlock}"
                       Text="{Binding AcademicYear}"/>

            <Label Grid.Column="0" Grid.Row="2" Content="Course" Style="{StaticResource DefaultLabel}"/>
            <TextBlock Grid.Column="1" Grid.Row="2" Style="{StaticResource DefaultTextBlock}"
                       Text="{Binding Course}"/>

            <Label Grid.Column="0" Grid.Row="3" Content="Class" Style="{StaticResource DefaultLabel}"/>
            <TextBlock Grid.Column="1" Grid.Row="3" Style="{StaticResource DefaultTextBlock}"
                       Text="{Binding Class}"/>

            <Label Grid.Column="0" Grid.Row="4" Content="Section" Style="{StaticResource DefaultLabel}"/>
            <TextBlock Grid.Column="1" Grid.Row="4" Style="{StaticResource DefaultTextBlock}"
                       Text="{Binding Section}"/>

            <Label Grid.Column="0" Grid.Row="5" Content="Open Day" Style="{StaticResource DefaultLabel}"/>
            <TextBlock Grid.Column="1" Grid.Row="5" Style="{StaticResource DefaultTextBlock}"
                       Text="{Binding Section.OpenDay}"/>

            <Label Grid.Column="0" Grid.Row="6" Content="Start / End Time" Style="{StaticResource DefaultLabel}"/>
            <TextBlock Grid.Column="1" Grid.Row="6" Style="{StaticResource DefaultTextBlock}"
                       Text="{Binding Section.StartEndTime}"/>

            <Label Grid.Column="0" Grid.Row="7" Content="Duration" Style="{StaticResource DefaultLabel}"/>
            <TextBlock Grid.Column="1" Grid.Row="7" Style="{StaticResource DefaultTextBlock}"
                       Text="{Binding Section.CommencingCompletionDate}"/>

            <Label Grid.Column="3" Grid.Row="0" Content="Room" Style="{StaticResource DefaultLabel}"/>
            <TextBlock Grid.Column="4" Grid.Row="0" Style="{StaticResource DefaultTextBlock}"
                       Text="{Binding Section.Room}"/>

            <Label Grid.Column="3" Grid.Row="1" Content="Registered _Date" Style="{StaticResource DefaultLabel}"
                   Target="{Binding ElementName=RegisteredDatePicker, Mode=OneWay}"/>
            <sui:DateTimePicker Name="RegisteredDatePicker" Grid.Column="4" Grid.Row="1" Style="{StaticResource DefaultDateTimePickerW200}"
                                Value="{Binding RegisteredDate}"/>

            <CheckBox Name="ActiveCheckBox" Grid.Column="4" Grid.Row="2" IsChecked="{Binding Active}"
                      Content="Active" Style="{StaticResource DefaultCheckBox}"/>

            <Label Grid.Column="3" Grid.Row="3" Content="Re_signed Date" Style="{StaticResource DefaultLabel}"
                   Target="{Binding ElementName=ResignedDatePicker, Mode=OneWay}"/>
            <sui:DateTimePicker Name="ResignedDatePicker" Grid.Column="4" Grid.Row="3" Style="{StaticResource DefaultDateTimePickerW200}"
                                Value="{Binding ResignedDate}"
                                IsEnabled="{Binding Path=Active, Converter={StaticResource InverseBooleanConverter}}"/>

            <Label Grid.Column="3" Grid.Row="4" Content="Created Date" Style="{StaticResource DefaultLabel}"/>
            <TextBlock Name="cdtb" Grid.Column="4" Grid.Row="4" Style="{StaticResource DefaultTextBlock}" 
                       Text="{Binding CreatedDateLT, StringFormat={StaticResource DateTimePattern}}"
                       Visibility="{Binding Path=IsNew, Converter={StaticResource InverseBooleanToHiddenConverter}}"/>

            <Label Grid.Column="3" Grid.Row="5" Content="Created By" Style="{StaticResource DefaultLabel}"/>
            <TextBlock Grid.Column="4" Grid.Row="5" Style="{StaticResource DefaultTextBlock}" 
                       Text="{Binding CreatedBy}"
                       Visibility="{Binding Visibility, ElementName=cdtb}"/>

            <Label Grid.Column="3" Grid.Row="6" Content="Modified Date" Style="{StaticResource DefaultLabel}"/>
            <TextBlock Grid.Column="4" Grid.Row="6" Style="{StaticResource DefaultTextBlock}" 
                       Text="{Binding ModifiedDateLT, StringFormat={StaticResource DateTimePattern}}"
                       Visibility="{Binding Visibility, ElementName=cdtb}"/>

            <Label Grid.Column="3" Grid.Row="7" Content="Modified By" Style="{StaticResource DefaultLabel}"/>
            <TextBlock Grid.Column="4" Grid.Row="7" Style="{StaticResource DefaultTextBlock}" 
                       Text="{Binding ModifiedBy}"
                       Visibility="{Binding Visibility, ElementName=cdtb}"/>
        </Grid>
    </DockPanel>
</sui:SimpleWindow>
