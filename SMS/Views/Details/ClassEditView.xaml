<sui:SimpleWindow x:Class="CodeflexSystems.SMS.Views.ClassEditView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sui="http://codeflexsystems.com/SmartUI"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False"
        Title="{Binding ViewName}">
    <DockPanel Style="{StaticResource DefaultDockPanel}"
               FocusManager.FocusedElement="{Binding ElementName=ClassNameTextBox}">
        <StackPanel Style="{StaticResource DefaultStackPanelButtonBar}">
            <Button Name="OKButton" Style="{StaticResource DefaultOKButton}"/>
            <Button Name="CancelButton" Style="{StaticResource DefaultCancelButton}"/>
        </StackPanel>

        <Grid Grid.IsSharedSizeScope="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition SharedSizeGroup="TextBlockColumn"/>
                <ColumnDefinition Width="{StaticResource DefaultColumnGap}"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition SharedSizeGroup="TextBlockColumn"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Label Grid.Column="0" Grid.Row="0" Content="Class _Name" Style="{StaticResource DefaultLabel}"
                   Target="{Binding ElementName=ClassNameTextBox, Mode=OneWay}"/>
            <sui:AutoSelectTextBox Name="ClassNameTextBox" Grid.Column="1" Grid.Row="0" Style="{StaticResource DefaultAutoSelectTextBoxW200}"
                     Text="{Binding ClassName, NotifyOnValidationError=True, ValidatesOnExceptions=True}"/>

            <Label Grid.Column="0" Grid.Row="1" Content="D_escription" Style="{StaticResource DefaultLabel}"
                   Target="{Binding ElementName=DescriptionTextBox, Mode=OneWay}"/>
            <sui:AutoSelectTextBox Name="DescriptionTextBox" Grid.Column="1" Grid.Row="1" Style="{StaticResource DefaultAutoSelectTextBoxW200}"
                     Text="{Binding Description, NotifyOnValidationError=True, ValidatesOnExceptions=True}"
                     Grid.RowSpan="2" TextWrapping="Wrap" Height="52" VerticalScrollBarVisibility="Auto"/>

            <Label Grid.Column="0" Grid.Row="3" Content="Course" Style="{StaticResource DefaultLabel}"/>
            <TextBlock Grid.Column="1" Grid.Row="3" Style="{StaticResource DefaultTextBlock}"
                       Text="{Binding Course}"/>

            <Label Grid.Column="0" Grid.Row="4" Content="Academic Year" Style="{StaticResource DefaultLabel}"/>
            <TextBlock Grid.Column="1" Grid.Row="4" Style="{StaticResource DefaultTextBlock}"
                       Text="{Binding AcademicYear}"/>

            <Label Grid.Column="0" Grid.Row="5" Content="School" Style="{StaticResource DefaultLabel}"/>
            <TextBlock Grid.Column="1" Grid.Row="5" Style="{StaticResource DefaultTextBlock}"
                       Text="{Binding School}"/>
            
            <Label Grid.Column="3" Grid.Row="0" Content="Created Date" Style="{StaticResource DefaultLabel}"/>
            <TextBlock Name="cdtb" Grid.Column="6" Grid.Row="0" Style="{StaticResource DefaultTextBlock}" 
                       Text="{Binding CreatedDateLT, StringFormat={StaticResource DateTimePattern}}"
                       Visibility="{Binding Path=IsNew, Converter={StaticResource InverseBooleanToHiddenConverter}}"/>

            <Label Grid.Column="3" Grid.Row="1" Content="Created By" Style="{StaticResource DefaultLabel}"/>
            <TextBlock Grid.Column="4" Grid.Row="1" Style="{StaticResource DefaultTextBlock}" 
                       Text="{Binding CreatedBy}"
                       Visibility="{Binding Visibility, ElementName=cdtb}"/>

            <Label Grid.Column="3" Grid.Row="2" Content="Modified Date" Style="{StaticResource DefaultLabel}"/>
            <TextBlock Grid.Column="4" Grid.Row="2" Style="{StaticResource DefaultTextBlock}" 
                       Text="{Binding ModifiedDateLT, StringFormat={StaticResource DateTimePattern}}"
                       Visibility="{Binding Visibility, ElementName=cdtb}"/>

            <Label Grid.Column="3" Grid.Row="3" Content="Modified By" Style="{StaticResource DefaultLabel}"/>
            <TextBlock Grid.Column="4" Grid.Row="3" Style="{StaticResource DefaultTextBlock}" 
                       Text="{Binding ModifiedBy}"
                       Visibility="{Binding Visibility, ElementName=cdtb}"/>
        </Grid>
    </DockPanel>
</sui:SimpleWindow>
