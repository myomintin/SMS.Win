<sui:SimpleWindow x:Class="CodeflexSystems.SMS.Views.UserPermissionsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sui="http://codeflexsystems.com/SmartUI"
        Width="750" Height="500" ResizeMode="NoResize" ShowInTaskbar="False"
        Title="{Binding ViewName}">
    <DockPanel Style="{StaticResource DefaultDockPanel}">
        <StackPanel Style="{StaticResource DefaultStackPanelButtonBar}">
            <Button Name="OKButton" Style="{StaticResource DefaultOKButton}"/>
            <Button Name="CancelButton" Style="{StaticResource DefaultCancelButton}"/>
        </StackPanel>

        <Grid Margin="0,0,0,5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            
            <sui:ModernMenu Name="GroupMenus" Margin="0,0,0,10"/>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <TreeView Name="MenusTreeView" Grid.Column="0"/>
                <Grid Grid.Column="1" Margin="20,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <WrapPanel Grid.Row="0">
                        <Button Content="_Preview Menus" Click="PreviewMenusButton_Click"
                                Style="{StaticResource DefaultLeftButton}"/>
                    </WrapPanel>
                    <GroupBox Grid.Row="1" Margin="0,10" Header="Menu Permissions Information">
                        <StackPanel Margin="5,5,5,3">
                            <TextBlock Text="1. Checks the menus of the left panel."
                                       TextWrapping="Wrap" Margin="0,0,0,5"/>
                            <TextBlock Text="2. Clicks the Preview Menus button and then you would see the menus for that user."
                                       TextWrapping="Wrap" Margin="0,0,0,5"/>
                            <TextBlock Text="3. Clicks the OK button."
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </GroupBox>
                    <Grid Name="MenuInfoGrid" Grid.Row="2" Margin="10,5" Visibility="Hidden">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Label Grid.Column="0" Grid.Row="0" Content="Created Date" Style="{StaticResource DefaultLabelReadOnly}"/>
                        <TextBlock Name="cdtb" Grid.Column="1" Grid.Row="0" Style="{StaticResource DefaultTextBlockReadOnly}" 
                                   Text="{Binding CreatedDateLT, StringFormat={StaticResource DateTimePattern}}"
                                   Visibility="{Binding Path=IsNew, Converter={StaticResource InverseBooleanToHiddenConverter}}"/>

                        <Label Grid.Column="0" Grid.Row="1" Content="Created By" Style="{StaticResource DefaultLabelReadOnly}"/>
                        <TextBlock Grid.Column="1" Grid.Row="1" Style="{StaticResource DefaultTextBlockReadOnly}" 
                                   Text="{Binding CreatedBy}"
                                   Visibility="{Binding Visibility, ElementName=cdtb}"/>

                        <Label Grid.Column="0" Grid.Row="2" Content="Modified Date" Style="{StaticResource DefaultLabelReadOnly}"/>
                        <TextBlock Grid.Column="1" Grid.Row="2" Style="{StaticResource DefaultTextBlockReadOnly}" 
                                   Text="{Binding ModifiedDateLT, StringFormat={StaticResource DateTimePattern}}"
                                   Visibility="{Binding Visibility, ElementName=cdtb}"/>

                        <Label Grid.Column="0" Grid.Row="3" Content="Modified By" Style="{StaticResource DefaultLabelReadOnly}"/>
                        <TextBlock Grid.Column="1" Grid.Row="3" Style="{StaticResource DefaultTextBlockReadOnly}" 
                                   Text="{Binding ModifiedBy}"
                                   Visibility="{Binding Visibility, ElementName=cdtb}"/>
                    </Grid>
                    <GroupBox Grid.Row="3" Header="Warning" Visibility="{Binding IsLogonUser, Converter={StaticResource BooleanToHiddenConverter}}">
                        <TextBlock Text="Changing permissions of the current logged on user will be effected the next time logon."
                                   TextWrapping="Wrap" Margin="5,5,5,3"/>
                    </GroupBox>
                </Grid>
            </Grid>
        </Grid>
    </DockPanel>
</sui:SimpleWindow>
