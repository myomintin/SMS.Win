<sui:SimpleWindow x:Class="CodeflexSystems.SMS.Views.UserEditView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sui="http://codeflexsystems.com/SmartUI"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False"
        Title="{Binding ViewName}">
    <DockPanel Style="{StaticResource DefaultDockPanel}"
               FocusManager.FocusedElement="{Binding ElementName=UserNameTextBox}">
        <Grid Style="{StaticResource DefaultGridButtonBar}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Content="_Permissions" Style="{StaticResource DefaultLeftButton}"
                        Command="{Binding UserParent.DeleteCommand}"
                        CommandParameter="{Binding RelativeSource={x:Static RelativeSource.Self}}"/>
                <Button Content="_Reset Password" Style="{StaticResource DefaultRightButton}"
                        Command="{Binding UserParent.SaveCommand}"
                        CommandParameter="{Binding RelativeSource={x:Static RelativeSource.Self}}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Name="OKButton" Style="{StaticResource DefaultOKButton}"/>
                <Button Name="CancelButton" Style="{StaticResource DefaultCancelButton}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.IsSharedSizeScope="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition SharedSizeGroup="TextBlockColumn"/>
                <ColumnDefinition Width="{StaticResource DefaultColumnGap}"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition SharedSizeGroup="TextBlockColumn"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Label Grid.Column="0" Grid.Row="0" Content="User _Name" Style="{StaticResource DefaultLabel}"
                   Target="{Binding ElementName=UserNameTextBox, Mode=OneWay}"/>
            <sui:AutoSelectTextBox Name="UserNameTextBox" Grid.Column="1" Grid.Row="0" Style="{StaticResource DefaultAutoSelectTextBoxW200}"
                     Text="{Binding UserName, NotifyOnValidationError=True, ValidatesOnExceptions=True}"/>

            <Label Grid.Column="0" Grid.Row="1" Content="_Full Name" Style="{StaticResource DefaultLabel}"
                   Target="{Binding ElementName=FullNameTextBox, Mode=OneWay}"/>
            <sui:AutoSelectTextBox Name="FullNameTextBox" Grid.Column="1" Grid.Row="1" Style="{StaticResource DefaultAutoSelectTextBoxW200}"
                     Text="{Binding FullName, NotifyOnValidationError=True, ValidatesOnExceptions=True}"/>

            <Label Grid.Column="0" Grid.Row="2" Content="D_escription" Style="{StaticResource DefaultLabel}"
                   Target="{Binding ElementName=DescriptionTextBox, Mode=OneWay}"/>
            <sui:AutoSelectTextBox Name="DescriptionTextBox" Grid.Column="1" Grid.Row="2" Style="{StaticResource DefaultAutoSelectTextBoxW200}"
                     Text="{Binding Description, NotifyOnValidationError=True, ValidatesOnExceptions=True}"
                     Grid.RowSpan="2" TextWrapping="Wrap" Height="52" VerticalScrollBarVisibility="Auto"/>

            <CheckBox Grid.Column="1" Grid.Row="4" IsChecked="{Binding Disabled}" Content="Disabled"
                      IsEnabled="{Binding IsLogonUser, Mode=OneWay, Converter={StaticResource InverseBooleanConverter}}" Style="{StaticResource DefaultCheckBox}"/>
            
            <Label Grid.Column="0" Grid.Row="5" Content="Disabled Date" Style="{StaticResource DefaultLabel}"/>
            <TextBlock Grid.Column="1" Grid.Row="5" Style="{StaticResource DefaultTextBlock}"
                       Text="{Binding DisabledDateLT, StringFormat={StaticResource DateTimePattern}}"/>

            <Label Grid.Column="0" Grid.Row="6" Content="Logon Date" Style="{StaticResource DefaultLabel}"/>
            <TextBlock Grid.Column="1" Grid.Row="6" Style="{StaticResource DefaultTextBlock}"
                       Text="{Binding LogonDateLT, StringFormat={StaticResource DateTimePattern}}"/>

            <Label Grid.Column="3" Grid.Row="0" Content="Password Modified Date" Style="{StaticResource DefaultLabel}"/>
            <TextBlock Grid.Column="4" Grid.Row="0" Style="{StaticResource DefaultTextBlock}"
                   Text="{Binding PasswordModifiedDateLT, StringFormat={StaticResource DateTimePattern}}"/>

            <Label Grid.Column="3" Grid.Row="1" Content="Password Failures" Style="{StaticResource DefaultLabel}"/>
            <TextBlock Grid.Column="4" Grid.Row="1" Style="{StaticResource DefaultTextBlock}"
                       Text="{Binding PasswordFailures}"/>

            <Label Grid.Column="3" Grid.Row="2" Content="Password Failure Date" Style="{StaticResource DefaultLabel}"/>
            <TextBlock Grid.Column="4" Grid.Row="2" Style="{StaticResource DefaultTextBlock}"
                       Text="{Binding PasswordFailureDateLT, StringFormat={StaticResource DateTimePattern}}"/>

            <Label Grid.Column="3" Grid.Row="3" Content="Created Date" Style="{StaticResource DefaultLabel}"/>
            <TextBlock Name="cdtb" Grid.Column="4" Grid.Row="3" Style="{StaticResource DefaultTextBlock}" 
                       Text="{Binding CreatedDateLT, StringFormat={StaticResource DateTimePattern}}"
                       Visibility="{Binding Path=IsNew, Converter={StaticResource InverseBooleanToHiddenConverter}}"/>

            <Label Grid.Column="3" Grid.Row="4" Content="Created By" Style="{StaticResource DefaultLabel}"/>
            <TextBlock Grid.Column="4" Grid.Row="4" Style="{StaticResource DefaultTextBlock}" 
                       Text="{Binding CreatedBy}"
                       Visibility="{Binding Visibility, ElementName=cdtb}"/>

            <Label Grid.Column="3" Grid.Row="5" Content="Modified Date" Style="{StaticResource DefaultLabel}"/>
            <TextBlock Grid.Column="4" Grid.Row="5" Style="{StaticResource DefaultTextBlock}" 
                       Text="{Binding ModifiedDateLT, StringFormat={StaticResource DateTimePattern}}"
                       Visibility="{Binding Visibility, ElementName=cdtb}"/>

            <Label Grid.Column="3" Grid.Row="6" Content="Modified By" Style="{StaticResource DefaultLabel}"/>
            <TextBlock Grid.Column="4" Grid.Row="6" Style="{StaticResource DefaultTextBlock}" 
                       Text="{Binding ModifiedBy}"
                       Visibility="{Binding Visibility, ElementName=cdtb}"/>
        </Grid>
    </DockPanel>
</sui:SimpleWindow>
