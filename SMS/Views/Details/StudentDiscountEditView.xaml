<sui:SimpleWindow x:Class="CodeflexSystems.SMS.Views.StudentDiscountEditView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sui="http://codeflexsystems.com/SmartUI"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False"
        Title="{Binding ViewName}">
    <DockPanel Style="{StaticResource DefaultDockPanel}"
               FocusManager.FocusedElement="{Binding ElementName=DiscountPercentageSingleUpDown}">
        <StackPanel Style="{StaticResource DefaultStackPanelButtonBar}">
            <Button Name="OKButton" Style="{StaticResource DefaultOKButton}"/>
            <Button Name="CancelButton" Style="{StaticResource DefaultCancelButton}"/>
        </StackPanel>

        <Grid Grid.IsSharedSizeScope="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition SharedSizeGroup="TextBlockColumn"/>
                <ColumnDefinition Width="{StaticResource DefaultColumnGap}"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition SharedSizeGroup="TextBlockColumn"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Label Grid.Column="0" Grid.Row="0" Content="Currency" Style="{StaticResource DefaultLabel}"/>
            <TextBlock Grid.Column="1" Grid.Row="0" Style="{StaticResource DefaultTextBlock}"
                       Text="{Binding Section.Currency}"/>

            <Label Grid.Column="0" Grid.Row="1" Content="Amount" Style="{StaticResource DefaultLabel}"/>
            <TextBlock Grid.Column="1" Grid.Row="1" Style="{StaticResource DefaultTextBlock}"
                       Text="{Binding Section.Fee, StringFormat=\{0:N\}}"/>

            <Label Grid.Column="0" Grid.Row="2" Content="_Discount %" Style="{StaticResource DefaultLabel}"
                   Target="{Binding ElementName=DiscountPercentageDecimalUpDown, Mode=OneWay}"/>
            <sui:DecimalUpDown Name="DiscountPercentageDecimalUpDown" Grid.Column="1" Grid.Row="2" Style="{StaticResource DefaultDecimalUpDown}"
                               Value="{Binding DiscountPercentage, NotifyOnValidationError=True, ValidatesOnExceptions=True}"
                               Minimum="0" Maximum="100"/>

            <Label Grid.Column="0" Grid.Row="3" Content="Dis_count" Style="{StaticResource DefaultLabel}"
                       Target="{Binding ElementName=DiscountAmountDecimalUpDown, Mode=OneWay}"/>
            <sui:DecimalUpDown Name="DiscountAmountDecimalUpDown" Grid.Column="1" Grid.Row="3" Style="{StaticResource DefaultDecimalUpDown}"
                               Value="{Binding DiscountAmount, NotifyOnValidationError=True, ValidatesOnExceptions=True}"
                               Minimum="0"/>

            <Label Grid.Column="0" Grid.Row="4" Content="D_escription" Style="{StaticResource DefaultLabel}"
                   Target="{Binding ElementName=DescriptionTextBox, Mode=OneWay}"/>
            <sui:AutoSelectTextBox Name="DescriptionTextBox" Grid.Column="1" Grid.Row="4" Style="{StaticResource DefaultAutoSelectTextBoxW200}"
                     Text="{Binding Description, NotifyOnValidationError=True, ValidatesOnExceptions=True}"
                     Grid.RowSpan="2" TextWrapping="Wrap" Height="52" VerticalScrollBarVisibility="Auto"/>

            <Label Grid.Column="0" Grid.Row="6" Content="Student" Style="{StaticResource DefaultLabel}"/>
            <TextBlock Grid.Column="1" Grid.Row="6" Style="{StaticResource DefaultTextBlock}"
                       Text="{Binding Student.StudentFullName}"/>

            <Label Grid.Column="0" Grid.Row="7" Content="Section" Style="{StaticResource DefaultLabel}"/>
            <TextBlock Grid.Column="1" Grid.Row="7" Style="{StaticResource DefaultTextBlock}"
                       Text="{Binding Section}"/>

            <Label Grid.Column="0" Grid.Row="8" Content="Registered Date" Style="{StaticResource DefaultLabel}"/>
            <TextBlock Grid.Column="1" Grid.Row="8" Style="{StaticResource DefaultTextBlock}"
                       Text="{Binding StudentSection.RegisteredDate, StringFormat={StaticResource DatePattern}}"/>

            <Label Grid.Column="0" Grid.Row="9" Content="Active" Style="{StaticResource DefaultLabel}"/>
            <TextBlock Grid.Column="1" Grid.Row="9" Style="{StaticResource DefaultTextBlock}"
                       Text="{Binding StudentSection.Active, Converter={StaticResource BooleanToYesNoConverter}}"/>

            <Label Grid.Column="3" Grid.Row="0" Content="Resigned Date" Style="{StaticResource DefaultLabel}"/>
            <TextBlock Grid.Column="4" Grid.Row="0" Style="{StaticResource DefaultTextBlock}"
                       Text="{Binding StudentSection.ResignedDate, StringFormat={StaticResource DatePattern}}"/>

            <Label Grid.Column="3" Grid.Row="1" Content="Open Day / Time" Style="{StaticResource DefaultLabel}"/>
            <TextBlock Grid.Column="4" Grid.Row="1" Style="{StaticResource DefaultTextBlock}"
                       Text="{Binding Section.OpenDayStartEndTime}"/>

            <Label Grid.Column="3" Grid.Row="2" Content="Class" Style="{StaticResource DefaultLabel}"/>
            <TextBlock Grid.Column="4" Grid.Row="2" Style="{StaticResource DefaultTextBlock}"
                       Text="{Binding Class}"/>

            <Label Grid.Column="3" Grid.Row="3" Content="Course" Style="{StaticResource DefaultLabel}"/>
            <TextBlock Grid.Column="4" Grid.Row="3" Style="{StaticResource DefaultTextBlock}"
                       Text="{Binding Course}"/>

            <Label Grid.Column="3" Grid.Row="4" Content="Academic Year" Style="{StaticResource DefaultLabel}"/>
            <TextBlock Grid.Column="4" Grid.Row="4" Style="{StaticResource DefaultTextBlock}"
                       Text="{Binding AcademicYear}"/>

            <Label Grid.Column="3" Grid.Row="5" Content="School" Style="{StaticResource DefaultLabel}"/>
            <TextBlock Grid.Column="4" Grid.Row="5" Style="{StaticResource DefaultTextBlock}"
                       Text="{Binding School}"/>

            <Label Grid.Column="3" Grid.Row="6" Content="Created Date" Style="{StaticResource DefaultLabel}"/>
            <TextBlock Name="cdtb" Grid.Column="4" Grid.Row="6" Style="{StaticResource DefaultTextBlock}" 
                       Text="{Binding CreatedDateLT, StringFormat={StaticResource DateTimePattern}}"
                       Visibility="{Binding Path=IsNew, Converter={StaticResource InverseBooleanToHiddenConverter}}"/>

            <Label Grid.Column="3" Grid.Row="7" Content="Created By" Style="{StaticResource DefaultLabel}"/>
            <TextBlock Grid.Column="4" Grid.Row="7" Style="{StaticResource DefaultTextBlock}" 
                       Text="{Binding CreatedBy}"
                       Visibility="{Binding Visibility, ElementName=cdtb}"/>
            
            <Label Grid.Column="3" Grid.Row="8" Content="Modified Date" Style="{StaticResource DefaultLabel}"/>
            <TextBlock Grid.Column="4" Grid.Row="8" Style="{StaticResource DefaultTextBlock}" 
                       Text="{Binding ModifiedDateLT, StringFormat={StaticResource DateTimePattern}}"
                       Visibility="{Binding Visibility, ElementName=cdtb}"/>

            <Label Grid.Column="3" Grid.Row="9" Content="Modified By" Style="{StaticResource DefaultLabel}"/>
            <TextBlock Grid.Column="4" Grid.Row="9" Style="{StaticResource DefaultTextBlock}" 
                       Text="{Binding ModifiedBy}"
                       Visibility="{Binding Visibility, ElementName=cdtb}"/>
        </Grid>
    </DockPanel>
</sui:SimpleWindow>
