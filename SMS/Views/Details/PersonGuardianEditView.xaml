<sui:SimpleWindow x:Class="CodeflexSystems.SMS.Views.PersonGuardianEditView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sui="http://codeflexsystems.com/SmartUI"
        xmlns:controls="clr-namespace:CodeflexSystems.SMS.Controls"
        xmlns:views="clr-namespace:CodeflexSystems.SMS.Views"
        Width="700" Height="570" ResizeMode="NoResize" ShowInTaskbar="False"
        Title="{Binding ViewName}">
    <DockPanel Style="{StaticResource DefaultDockPanelWithTabControl}">
        <StackPanel Style="{StaticResource DefaultStackPanelButtonBarWithTabControl}">
            <Button Name="OKButton" Style="{StaticResource DefaultOKButton}"/>
            <Button Name="CancelButton" Style="{StaticResource DefaultCancelButton}"/>
        </StackPanel>

        <TabControl>
            <TabItem Header="Guardian">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="{StaticResource DefaultColumnGap}"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Column="0" Grid.Row="0" Content="_Title" Style="{StaticResource DefaultLabel}"
                           Target="{Binding ElementName=TitleTextBox, Mode=OneWay}"/>
                    <sui:AutoSelectTextBox Name="TitleTextBox" Grid.Column="1" Grid.Row="0" Style="{StaticResource DefaultAutoSelectTextBoxMW200}"
                             Text="{Binding GuardianViewModel.Title, NotifyOnValidationError=True, ValidatesOnExceptions=True}"/>

                    <Label Grid.Column="0" Grid.Row="1" Content="Guardian _Name" Style="{StaticResource DefaultLabel}"
                           Target="{Binding ElementName=GuardianNameTextBox, Mode=OneWay}"/>
                    <sui:AutoSelectTextBox Name="GuardianNameTextBox" Grid.Column="1" Grid.Row="1" Style="{StaticResource DefaultAutoSelectTextBoxMW200}"
                             Text="{Binding GuardianViewModel.GuardianName, NotifyOnValidationError=True, ValidatesOnExceptions=True}"/>

                    <Label Grid.Column="0" Grid.Row="2" Content="_Gender" Style="{StaticResource DefaultLabel}"
                           Target="{Binding ElementName=MaleRadioButton, Mode=OneWay}"/>
                    <StackPanel Grid.Column="1" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left">
                        <RadioButton Content="Male" Name="MaleRadioButton" GroupName="Gender" Checked="GenderChecked" IsChecked="True"/>
                        <RadioButton Content="Female" Name="FemaleRadioButton" GroupName="Gender" Checked="GenderChecked" Margin="10,0,0,0"/>
                    </StackPanel>

                    <Label Grid.Column="0" Grid.Row="3" Content="_Birth Date" Style="{StaticResource DefaultLabel}"
                           Target="{Binding ElementName=BirthDatePicker, Mode=OneWay}"/>
                    <sui:DateTimePicker Name="BirthDatePicker" Grid.Column="1" Grid.Row="3" Style="{StaticResource DefaultDateTimePickerMW200}"
                                        Value="{Binding GuardianViewModel.BirthDate}"/>

                    <Label Grid.Column="0" Grid.Row="4" Content="Birth _Country" Style="{StaticResource DefaultLabel}"
                           Target="{Binding ElementName=BirthCountryComboBox, Mode=OneWay}"/>
                    <ComboBox Name="BirthCountryComboBox" Grid.Column="1" Grid.Row="4" Style="{StaticResource DefaultComboBoxMW200}"
                              SelectedItem="{Binding GuardianViewModel.BirthCountry, Mode=TwoWay}"
                              ItemsSource="{Binding GuardianViewModel.Countries}"/>

                    <Label Grid.Column="0" Grid.Row="5" Content="Nationalit_y" Style="{StaticResource DefaultLabel}"
                           Target="{Binding ElementName=NationalityTextBox, Mode=OneWay}"/>
                    <sui:AutoSelectTextBox Name="NationalityTextBox" Grid.Column="1" Grid.Row="5" Style="{StaticResource DefaultAutoSelectTextBoxMW200}"
                             Text="{Binding GuardianViewModel.Nationality, NotifyOnValidationError=True, ValidatesOnExceptions=True}"/>

                    <Label Grid.Column="0" Grid.Row="6" Content="N_IRC No." Style="{StaticResource DefaultLabel}"
                           Target="{Binding ElementName=NIRCTextBox, Mode=OneWay}"/>
                    <sui:AutoSelectTextBox Name="NIRCTextBox" Grid.Column="1" Grid.Row="6" Style="{StaticResource DefaultAutoSelectTextBoxMW200}"
                             Text="{Binding GuardianViewModel.NIRC, NotifyOnValidationError=True, ValidatesOnExceptions=True}"/>

                    <Label Grid.Column="0" Grid.Row="7" Content="_Religion" Style="{StaticResource DefaultLabel}"
                           Target="{Binding ElementName=ReligionComboBox, Mode=OneWay}"/>
                    <ComboBox Name="ReligionComboBox" Grid.Column="1" Grid.Row="7" Style="{StaticResource DefaultComboBoxMW200}"
                              SelectedItem="{Binding GuardianViewModel.Religion, Mode=TwoWay}"
                              ItemsSource="{Binding GuardianViewModel.Religions}"/>

                    <Label Grid.Column="0" Grid.Row="8" Content="Ed_ucation" Style="{StaticResource DefaultLabel}"
                           Target="{Binding ElementName=EducationTextBox, Mode=OneWay}"/>
                    <sui:AutoSelectTextBox Name="EducationTextBox" Grid.Column="1" Grid.Row="8" Style="{StaticResource DefaultAutoSelectTextBoxMW200}"
                             Text="{Binding GuardianViewModel.Education, NotifyOnValidationError=True, ValidatesOnExceptions=True}"/>

                    <Label Grid.Column="0" Grid.Row="9" Content="E_mployment" Style="{StaticResource DefaultLabel}"
                           Target="{Binding ElementName=EmploymentTextBox, Mode=OneWay}"/>
                    <sui:AutoSelectTextBox Name="EmploymentTextBox" Grid.Column="1" Grid.Row="9" Style="{StaticResource DefaultAutoSelectTextBoxMW200}"
                             Text="{Binding GuardianViewModel.Employment, NotifyOnValidationError=True, ValidatesOnExceptions=True}"/>

                    <Label Grid.Column="0" Grid.Row="10" Content="_Designation" Style="{StaticResource DefaultLabel}"
                           Target="{Binding ElementName=DesignationTextBox, Mode=OneWay}"/>
                    <sui:AutoSelectTextBox Name="DesignationTextBox" Grid.Column="1" Grid.Row="10" Style="{StaticResource DefaultAutoSelectTextBoxMW200}"
                             Text="{Binding GuardianViewModel.Designation, NotifyOnValidationError=True, ValidatesOnExceptions=True}"/>

                    <Label Grid.Column="3" Grid.Row="0" Content="Photo" Style="{StaticResource DefaultLabel}"/>
                    <controls:ImageViewer x:Name="PhotoViewer" Grid.Column="4" Grid.Row="0" Grid.RowSpan="4"
                                          Source="{Binding GuardianViewModel.Photo, Mode=TwoWay}"
                                          DefaultImageValue="{Binding GuardianViewModel.Gender, Mode=OneWay}"
                                          Style="{StaticResource DefaultImageViewer}">
                        <controls:ImageViewer.DefaultImageList>
                            <controls:ImageDictionary>
                                <Image x:Key="True" Source="/Resources/gender.male.png"/>
                                <Image x:Key="False" Source="/Resources/gender.female.png"/>
                            </controls:ImageDictionary>
                        </controls:ImageViewer.DefaultImageList>
                    </controls:ImageViewer>

                    <Label Grid.Column="3" Grid.Row="4" Content="_Passport" Style="{StaticResource DefaultLabel}"
                           Target="{Binding ElementName=PassportTextBox, Mode=OneWay}"/>
                    <sui:AutoSelectTextBox Name="PassportTextBox" Grid.Column="4" Grid.Row="4" Style="{StaticResource DefaultAutoSelectTextBoxMW200}"
                             Text="{Binding GuardianViewModel.Passport, NotifyOnValidationError=True, ValidatesOnExceptions=True}"/>

                    <Label Grid.Column="3" Grid.Row="5" Content="_Visa" Style="{StaticResource DefaultLabel}"
                           Target="{Binding ElementName=VisaTextBox, Mode=OneWay}"/>
                    <sui:AutoSelectTextBox Name="VisaTextBox" Grid.Column="4" Grid.Row="5" Style="{StaticResource DefaultAutoSelectTextBoxMW200}"
                             Text="{Binding GuardianViewModel.Visa, NotifyOnValidationError=True, ValidatesOnExceptions=True}"/>

                    <Label Grid.Column="3" Grid.Row="6" Content="D_escription" Style="{StaticResource DefaultLabel}"
                           Target="{Binding ElementName=DescriptionTextBox, Mode=OneWay}"/>
                    <sui:AutoSelectTextBox Name="DescriptionTextBox" Grid.Column="4" Grid.Row="6" Style="{StaticResource DefaultAutoSelectTextBoxMW200}"
                            Text="{Binding GuardianViewModel.Description, NotifyOnValidationError=True, ValidatesOnExceptions=True}"
                            Grid.RowSpan="2" TextWrapping="Wrap" Height="52" VerticalScrollBarVisibility="Auto"/>

                    <Label Grid.Column="3" Grid.Row="8" Content="Created Date" Style="{StaticResource DefaultLabel}"/>
                    <TextBlock Name="cdtb1" Grid.Column="4" Grid.Row="8" Style="{StaticResource DefaultTextBlock}" 
                               Text="{Binding GuardianViewModel.CreatedDateLT, StringFormat={StaticResource DateTimePattern}}"
                               Visibility="{Binding Path=GuardianViewModel.IsNew, Converter={StaticResource InverseBooleanToHiddenConverter}}"/>

                    <Label Grid.Column="3" Grid.Row="9" Content="Created By" Style="{StaticResource DefaultLabel}"/>
                    <TextBlock Grid.Column="4" Grid.Row="9" Style="{StaticResource DefaultTextBlock}" 
                               Text="{Binding GuardianViewModel.CreatedBy}"
                               Visibility="{Binding Visibility, ElementName=cdtb1}"/>

                    <Label Grid.Column="3" Grid.Row="10" Content="Modified Date" Style="{StaticResource DefaultLabel}"/>
                    <TextBlock Grid.Column="4" Grid.Row="10" Style="{StaticResource DefaultTextBlock}" 
                               Text="{Binding GuardianViewModel.ModifiedDateLT, StringFormat={StaticResource DateTimePattern}}"
                               Visibility="{Binding Visibility, ElementName=cdtb1}"/>

                    <Label Grid.Column="3" Grid.Row="11" Content="Modified By" Style="{StaticResource DefaultLabel}"/>
                    <TextBlock Grid.Column="4" Grid.Row="11" Style="{StaticResource DefaultTextBlock}" 
                               Text="{Binding GuardianViewModel.ModifiedBy}"
                               Visibility="{Binding Visibility, ElementName=cdtb1}"/>
                    
                    <Separator Grid.Column="0" Grid.Row="12" Grid.ColumnSpan="5" Style="{DynamicResource DefaultSeparator}"/>
                    
                    <Label Grid.Column="0" Grid.Row="13" Content="_Guardian Type" Style="{StaticResource DefaultLabel}"
                           Target="{Binding ElementName=GuardianTypeComboBox, Mode=OneWay}"/>
                    <ComboBox Name="GuardianTypeComboBox" Grid.Column="1" Grid.Row="13" Style="{StaticResource DefaultComboBoxMW200}"
                              SelectedItem="{Binding GuardianType, Mode=TwoWay}" ItemsSource="{Binding GuardianTypes}"/>

                    <Label Grid.Column="0" Grid.Row="14" Content="Created Date" Style="{StaticResource DefaultLabel}"/>
                    <TextBlock Name="cdtb" Grid.Column="1" Grid.Row="14" Style="{StaticResource DefaultTextBlock}" 
                               Text="{Binding CreatedDateLT, StringFormat={StaticResource DateTimePattern}}"
                               Visibility="{Binding Path=IsNew, Converter={StaticResource InverseBooleanToHiddenConverter}}"/>

                    <Label Grid.Column="0" Grid.Row="15" Content="Created By" Style="{StaticResource DefaultLabel}"/>
                    <TextBlock Grid.Column="1" Grid.Row="15" Style="{StaticResource DefaultTextBlock}" 
                               Text="{Binding CreatedBy}"
                               Visibility="{Binding Visibility, ElementName=cdtb}"/>

                    <Label Grid.Column="3" Grid.Row="14" Content="Modified Date" Style="{StaticResource DefaultLabel}"/>
                    <TextBlock Grid.Column="4" Grid.Row="14" Style="{StaticResource DefaultTextBlock}" 
                               Text="{Binding ModifiedDateLT, StringFormat={StaticResource DateTimePattern}}"
                               Visibility="{Binding Visibility, ElementName=cdtb}"/>

                    <Label Grid.Column="3" Grid.Row="15" Content="Modified By" Style="{StaticResource DefaultLabel}"/>
                    <TextBlock Grid.Column="4" Grid.Row="15" Style="{StaticResource DefaultTextBlock}" 
                               Text="{Binding ModifiedBy}"
                               Visibility="{Binding Visibility, ElementName=cdtb}"/>
                </Grid>
            </TabItem>
            <TabItem Header="Addresses">
                <views:PersonAddressListView DataContext="{Binding GuardianViewModel}"/>
            </TabItem>
            <TabItem Header="Emails">
                <views:EmailListView DataContext="{Binding GuardianViewModel}"/>
            </TabItem>
            <TabItem Header="Phones">
                <views:PhoneListView DataContext="{Binding GuardianViewModel}"/>
            </TabItem>
        </TabControl>
    </DockPanel>
</sui:SimpleWindow>
