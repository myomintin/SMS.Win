<sui:SimpleWindow x:Class="CodeflexSystems.SMS.Views.SearchSectionInfoView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sui="http://codeflexsystems.com/SmartUI"
        Width="1000" Height="500" ResizeMode="NoResize" ShowInTaskbar="False"
        Title="{Binding ViewName}">
    <DockPanel Style="{StaticResource DefaultDockPanel}"
               FocusManager.FocusedElement="{Binding ElementName=RegisteredDatePicker}">
        <StackPanel Style="{StaticResource DefaultStackPanelButtonBar}">
            <Button Name="OKButton" Style="{StaticResource DefaultOKButton}"/>
            <Button Name="CancelButton" Style="{StaticResource DefaultCancelButton}"/>
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            
            <Grid Margin="0,0,0,10" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="{StaticResource DefaultColumnGap}"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="{StaticResource DefaultColumnGap}"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Label Grid.Column="0" Grid.Row="0" Content="Sch_ool" Style="{StaticResource DefaultLabel}"
        			   Target="{Binding ElementName=SchoolComboBox, Mode=OneWay}"/>
                <ComboBox Name="SchoolComboBox" Grid.Column="1" Grid.Row="0" Style="{StaticResource DefaultComboBoxW200}"
        			      SelectedItem="{Binding Schools.SelectedItem, Mode=TwoWay}"
                          ItemsSource="{Binding Schools}"/>

                <Label Grid.Column="3" Grid.Row="0" Content="Academic _Year" Style="{StaticResource DefaultLabel}"
                       Target="{Binding ElementName=AcademicYearComboBox, Mode=OneWay}"/>
                <ComboBox Grid.Column="4" Grid.Row="0" Name="AcademicYearComboBox" Style="{StaticResource DefaultComboBoxW200}"
                          SelectedItem="{Binding AcademicYears.SelectedItem, Mode=TwoWay}"
                          ItemsSource="{Binding AcademicYears}"/>

                <Label Grid.Column="6" Grid.Row="0" Content="Registered _Date" Style="{StaticResource DefaultLabel}"
        			   Target="{Binding ElementName=RegisteredDatePicker, Mode=OneWay}"/>
                <sui:DateTimePicker Name="RegisteredDatePicker" Grid.Column="7" Grid.Row="0" Style="{StaticResource DefaultDateTimePickerW200}"
        			                Value="{Binding RegisteredDate}"/>
            </Grid>

            <DataGrid Name="ListDataGrid" Grid.Row="1" Style="{StaticResource DefaultDataGrid}"
                      SelectedItem="{Binding Collection.SelectedItem, Mode=TwoWay}"
                      ItemsSource="{Binding Collection}"
                      MouseDoubleClick="ListDataGrid_MouseDoubleClick"
                      SelectionChanged="ListDataGrid_SelectionChanged"
                      HorizontalAlignment="Stretch">
                <DataGrid.Columns>
                    <sui:DataGridTextColumn Header="Course" Binding="{Binding Course}"/>
                    <sui:DataGridTextColumn Header="Class" Binding="{Binding Class}"/>
                    <sui:DataGridTextColumn Header="Section" Binding="{Binding Section}"/>
                    <sui:DataGridTextColumn Header="Room" Binding="{Binding Section.Room}"/>
                    <sui:DataGridTextColumn Header="Open Day" Binding="{Binding Section.OpenDay}"/>
                    <sui:DataGridTextColumn Header="Start / End Time" Binding="{Binding Section.StartEndTime}"/>
                    <sui:DataGridTextColumn Header="Commencing / Completion Date" Binding="{Binding Section.CommencingCompletionDate}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</sui:SimpleWindow>
