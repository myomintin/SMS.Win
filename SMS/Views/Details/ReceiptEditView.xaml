<sui:SimpleWindow x:Class="CodeflexSystems.SMS.Views.ReceiptEditView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sui="http://codeflexsystems.com/SmartUI"
        Width="850"  Height="600" ResizeMode="NoResize" ShowInTaskbar="False"
        Title="{Binding ViewName}">
    <DockPanel Style="{StaticResource DefaultDockPanel}"
               FocusManager.FocusedElement="{Binding ElementName=ReceiptCodeTextBox}">
        <StackPanel Style="{StaticResource DefaultStackPanelButtonBar}">
            <Button Name="OKButton" Style="{StaticResource DefaultOKButton}"/>
            <Button Name="CancelButton" Style="{StaticResource DefaultCancelButton}"/>
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Column="0" Margin="0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="{StaticResource DefaultColumnGap}"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Column="0" Grid.Row="0" Content="C_urrency" Style="{StaticResource DefaultLabel}"
                       Target="{Binding ElementName=CurrencyComboBox, Mode=OneWay}"/>
                <ComboBox Name="CurrencyComboBox" Grid.Column="1" Grid.Row="0" Style="{StaticResource DefaultComboBoxW200}"
                          SelectedItem="{Binding Currency, Mode=TwoWay}" ItemsSource="{Binding Currencies}"/>

                <Label Grid.Column="0" Grid.Row="1" Content="Receipt _Date" Style="{StaticResource DefaultLabel}"
                       Target="{Binding ElementName=ReceiptDatePicker, Mode=OneWay}"/>
                <sui:DateTimePicker Name="ReceiptDatePicker" Grid.Column="1" Grid.Row="1" Style="{StaticResource DefaultDateTimePickerW200}"
                                    Value="{Binding ReceiptDate, NotifyOnValidationError=True, ValidatesOnExceptions=True}"/>

                <Label Grid.Column="0" Grid.Row="2" Content="Receipt _Code" Style="{StaticResource DefaultLabel}"
                       Target="{Binding ElementName=ReceiptCodeTextBox, Mode=OneWay}"/>
                <sui:AutoSelectTextBox Name="ReceiptCodeTextBox" Grid.Column="1" Grid.Row="2" Style="{StaticResource DefaultAutoSelectTextBoxW200}"
                         Text="{Binding ReceiptCode, NotifyOnValidationError=True, ValidatesOnExceptions=True}"/>

                <Label Grid.Column="0" Grid.Row="3" Content="Receipt _No." Style="{StaticResource DefaultLabel}"
                       Target="{Binding ElementName=ReceiptNoIntegerUpDown, Mode=OneWay}"/>
                <sui:IntegerUpDown Name="ReceiptNoIntegerUpDown" Grid.Column="1" Grid.Row="3" Style="{StaticResource DefaultIntegerUpDown}"
                                   Value="{Binding ReceiptNo, NotifyOnValidationError=True, ValidatesOnExceptions=True}"
                                   Minimum="0"/>

                <Label Grid.Column="0" Grid.Row="4" Content="_Tax %" Style="{StaticResource DefaultLabel}"
                       Target="{Binding ElementName=TaxPercentageDecimalUpDown, Mode=OneWay}"/>
                <sui:DecimalUpDown Name="TaxPercentageDecimalUpDown" Grid.Column="1" Grid.Row="4" Style="{StaticResource DefaultDecimalUpDown}"
                                   Value="{Binding TaxPercentage, NotifyOnValidationError=True, ValidatesOnExceptions=True}"
                                   Minimum="0"/>

                <Label Grid.Column="0" Grid.Row="5" Content="Ta_x" Style="{StaticResource DefaultLabel}"
                       Target="{Binding ElementName=TaxAmountDecimalUpDown, Mode=OneWay}"/>
                <sui:DecimalUpDown Name="TaxAmountDecimalUpDown" Grid.Column="1" Grid.Row="5" Style="{StaticResource DefaultDecimalUpDown}"
                                   Value="{Binding TaxAmount, NotifyOnValidationError=True, ValidatesOnExceptions=True}"
                                   Minimum="0"/>

                <Label Grid.Column="0" Grid.Row="6" Content="D_escription" Style="{StaticResource DefaultLabel}"
                       Target="{Binding ElementName=DescriptionTextBox, Mode=OneWay}"/>
                <sui:AutoSelectTextBox Name="DescriptionTextBox" Grid.Column="1" Grid.Row="6" Style="{StaticResource DefaultAutoSelectTextBoxW200}"
                         Text="{Binding Description, NotifyOnValidationError=True, ValidatesOnExceptions=True}"
                         Height="52" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

                <Label Grid.Column="3" Grid.Row="0" Content="Total Amount" Style="{StaticResource DefaultLabel}"/>
                <TextBlock Grid.Column="4" Grid.Row="0" Style="{StaticResource DefaultTextBlock}"
                           Text="{Binding TotalAmount, StringFormat=\{0:N\}}"/>

                <Label Grid.Column="3" Grid.Row="1" Content="Net Amount" Style="{StaticResource DefaultLabel}"/>
                <TextBlock Grid.Column="4" Grid.Row="1" Style="{StaticResource DefaultTextBlock}"
                           Text="{Binding NetAmount, StringFormat=\{0:N\}}"/>

                <Label Grid.Column="3" Grid.Row="2" Content="Created Date" Style="{StaticResource DefaultLabel}"/>
                <TextBlock Name="cdtb" Grid.Column="4" Grid.Row="2" Style="{StaticResource DefaultTextBlock}" 
                           Text="{Binding CreatedDateLT, StringFormat={StaticResource DateTimePattern}}"
                           Visibility="{Binding Path=IsNew, Converter={StaticResource InverseBooleanToHiddenConverter}}"/>

                <Label Grid.Column="3" Grid.Row="3" Content="Created By" Style="{StaticResource DefaultLabel}"/>
                <TextBlock Grid.Column="4" Grid.Row="3" Style="{StaticResource DefaultTextBlock}" 
                           Text="{Binding CreatedBy}"
                           Visibility="{Binding Visibility, ElementName=cdtb}"/>

                <Label Grid.Column="3" Grid.Row="4" Content="Modified Date" Style="{StaticResource DefaultLabel}"/>
                <TextBlock Grid.Column="4" Grid.Row="4" Style="{StaticResource DefaultTextBlock}" 
                           Text="{Binding ModifiedDateLT, StringFormat={StaticResource DateTimePattern}}"
                           Visibility="{Binding Visibility, ElementName=cdtb}"/>

                <Label Grid.Column="3" Grid.Row="5" Content="Modified By" Style="{StaticResource DefaultLabel}"/>
                <TextBlock Grid.Column="4" Grid.Row="5" Style="{StaticResource DefaultTextBlock}" 
                           Text="{Binding ModifiedBy}"
                           Visibility="{Binding Visibility, ElementName=cdtb}"/>
            </Grid>
            
            <sui:ContentSeparator Grid.Row="1" Content="Receipt Details"/>

            <WrapPanel Grid.Row="2" Margin="0,6">
                <Label Width="79" Content="_Fee Type" Style="{StaticResource DefaultLabel}"
                       Target="{Binding ElementName=FeeTypeTypeComboBox, Mode=OneWay}"
                       HorizontalContentAlignment="Right"/>
                <ComboBox Name="FeeTypeTypeComboBox" Style="{StaticResource DefaultComboBoxMW200}"
                          SelectedItem="{Binding FeeTypes.SelectedItem, Mode=TwoWay}"
                          ItemsSource="{Binding FeeTypes}" Margin="0,3,15,3"/>
                <Button Content="_Add" Command="{Binding AddReceiptDetailCommand}"
                        CommandParameter="{Binding RelativeSource={x:Static RelativeSource.Self}}"
                        Style="{StaticResource DefaultLeftButton}"/>
                <Button Name="EditButton" Content="_Edit" Command="{Binding EditReceiptDetailCommand}"
                        CommandParameter="{Binding RelativeSource={x:Static RelativeSource.Self}}"
                        Style="{StaticResource DefaultButton}"/>
                <Button Content="{Binding DeleteReceiptDetailContent}" Command="{Binding DeleteReceiptDetailCommand}"
                        Style="{StaticResource DefaultRightButton}"/>
            </WrapPanel>

            <DataGrid Name="ListDataGrid" Grid.Row="3" Style="{StaticResource DefaultDataGrid}"
                      SelectedItem="{Binding ReceiptDetailViewModels.SelectedItem, Mode=TwoWay}"
                      ItemsSource="{Binding ReceiptDetailViewModels}"
                      MouseDoubleClick="ListDataGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <sui:DataGridTextColumn Header="Id" Binding="{Binding Student.Id}"/>
                    <sui:DataGridTextColumn Header="Student" Binding="{Binding Student}"/>
                    <sui:DataGridTextColumn Header="Fee Type" Binding="{Binding FeeType}"/>
                    <sui:DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=\{0:N\}}"
                                            ElementStyle="{StaticResource DataGridRightTextStyle}"
                                            HeaderStyle="{StaticResource DataGridRightColumnHeader}"/>
                    <sui:DataGridTextColumn Header="Qty." Binding="{Binding Quantity}"
                                            ElementAlignment="Right" HeaderAlignment="Right"/>
                    <sui:DataGridTextColumn Header="Total" Binding="{Binding TotalAmount, StringFormat=\{0:N\}}"
                                            ElementAlignment="Right" HeaderAlignment="Right"/>
                    <sui:DataGridTextColumn Header="Discount" Binding="{Binding DiscountAmount, StringFormat=\{0:N\}}"
                                            ElementAlignment="Right" HeaderAlignment="Right"/>
                    <sui:DataGridTextColumn Header="Net Amount" Binding="{Binding NetAmount, StringFormat=\{0:N\}}"
                                            ElementAlignment="Right" HeaderAlignment="Right"/>
                    <!--<sui:DataGridTextColumn Header="Old State" Binding="{Binding OldObjectState}"/>
                    <sui:DataGridTextColumn Header="State" Binding="{Binding ObjectState}"/>
                    <sui:DataGridTextColumn Header="Old OAS" Binding="{Binding OldOverallState}"/>-->
                    <sui:DataGridTextColumn Header="Overall State" Binding="{Binding OverallState}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</sui:SimpleWindow>
