<sui:SimpleWindow x:Class="CodeflexSystems.SMS.Views.AddView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sui="http://codeflexsystems.com/SmartUI"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False"
        Title="{Binding ViewName}">
    <DockPanel Style="{StaticResource DefaultDockPanel}">
        <StackPanel Style="{StaticResource DefaultStackPanelButtonBar}">
            <Button Name="NextButton" Style="{StaticResource DefaultNextButton}"/>
            <Button Name="CancelButton" Style="{StaticResource DefaultCancelButton}"/>
        </StackPanel>
        
        <StackPanel Margin="15,20,0,10">
            <RadioButton Name="ExistingRadioButton" IsChecked="{Binding IsExisting}"
                         Content="{Binding ExistingContent}" Style="{StaticResource DefaultRadioButton}"
                         IsEnabled="{Binding EnableExisting}"/>
            <RadioButton Name="NewRadioButton" IsChecked="{Binding IsNew}"
                         Content="{Binding NewContent}" Style="{StaticResource DefaultRadioButton}"
                         IsEnabled="{Binding EnableNew}"/>
        </StackPanel>
    </DockPanel>
</sui:SimpleWindow>
