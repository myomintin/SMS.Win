<sui:SimpleWindow x:Class="CodeflexSystems.SMS.Views.ReceiptDetailEditView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sui="http://codeflexsystems.com/SmartUI"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False"
        Title="{Binding ViewName}">
    <DockPanel Style="{StaticResource DefaultDockPanel}">
        <StackPanel Style="{StaticResource DefaultStackPanelButtonBar}">
            <Button Name="OKButton" Style="{StaticResource DefaultOKButton}"/>
            <Button Name="CancelButton" Style="{StaticResource DefaultCancelButton}"/>
        </StackPanel>

        <Grid Grid.IsSharedSizeScope="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition SharedSizeGroup="TextBlockColumn" Width="200"/>
                <ColumnDefinition Width="{StaticResource DefaultColumnGap}"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition SharedSizeGroup="TextBlockColumn"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Label Grid.Column="0" Grid.Row="0" Content="_Fee Type" Style="{StaticResource DefaultLabel}"/>
            <TextBlock Grid.Column="1" Grid.Row="0" Style="{StaticResource DefaultTextBlock}"
                       Text="{Binding FeeType}"/>

            <Label Grid.Column="0" Grid.Row="1" Content="From _Month" Style="{StaticResource DefaultLabel}"
                   Target="{Binding ElementName=FromMonthDatePicker, Mode=OneWay}"/>
            <sui:DateTimePicker Name="FromMonthDatePicker" Grid.Column="1" Grid.Row="1" Style="{StaticResource DefaultDateTimePickerW200}"
                                Value="{Binding FromMonth, NotifyOnValidationError=True, ValidatesOnExceptions=True}"
                                IsEnabled="{Binding CanSelectMonth}" FormatString="MMMM yyyy" Watermark="Select a month"/>

            <Label Grid.Column="0" Grid.Row="2" Content="Quantity" Style="{StaticResource DefaultLabel}"
                   Target="{Binding ElementName=QuantityByteUpDown, Mode=OneWay}"/>
            <sui:ByteUpDown Name="QuantityByteUpDown" Grid.Column="1" Grid.Row="2" Style="{StaticResource DefaultByteUpDown}"
                            Value="{Binding Quantity, NotifyOnValidationError=True, ValidatesOnExceptions=True}"
                            Minimum="1" IsEnabled="{Binding CanSelectMonth}"/>

            <Label Grid.Column="0" Grid.Row="3" Content="To Month" Style="{StaticResource DefaultLabel}"/>
            <TextBlock Grid.Column="1" Grid.Row="3" Style="{StaticResource DefaultTextBlock}"
                       Text="{Binding ToMonth}"/>

            <Label Grid.Column="0" Grid.Row="4" Content="_Amount" Style="{StaticResource DefaultLabel}"
                   Target="{Binding ElementName=AmountDecimalUpDown, Mode=OneWay}"/>
            <sui:DecimalUpDown Name="AmountDecimalUpDown" Grid.Column="1" Grid.Row="4" Style="{StaticResource DefaultDecimalUpDown}"
                               Value="{Binding Amount, NotifyOnValidationError=True, ValidatesOnExceptions=True}"
                               Minimum="0"/>

            <Label Grid.Column="0" Grid.Row="5" Content="_Discount %" Style="{StaticResource DefaultLabel}"
                   Target="{Binding ElementName=DiscountPercentageDecimalUpDown, Mode=OneWay}"/>
            <sui:DecimalUpDown Name="DiscountPercentageDecimalUpDown" Grid.Column="1" Grid.Row="5" Style="{StaticResource DefaultDecimalUpDown}"
                               Value="{Binding DiscountPercentage, NotifyOnValidationError=True, ValidatesOnExceptions=True}"
                               Minimum="0" Maximum="100"/>

            <Label Grid.Column="0" Grid.Row="6" Content="Dis_count" Style="{StaticResource DefaultLabel}"
                   Target="{Binding ElementName=DiscountAmountDecimalUpDown, Mode=OneWay}"/>
            <sui:DecimalUpDown Name="DiscountAmountDecimalUpDown" Grid.Column="1" Grid.Row="6" Style="{StaticResource DefaultDecimalUpDown}"
                               Value="{Binding DiscountAmount, NotifyOnValidationError=True, ValidatesOnExceptions=True}"
                               Minimum="0"/>

            <Label Grid.Column="0" Grid.Row="7" Content="Total" Style="{StaticResource DefaultLabel}"/>
            <TextBlock Grid.Column="1" Grid.Row="7" Style="{StaticResource DefaultTextBlock}"
                       Text="{Binding TotalAmount, StringFormat=\{0:N\}}"/>

            <Label Grid.Column="0" Grid.Row="8" Content="Net Amount" Style="{StaticResource DefaultLabel}"/>
            <TextBlock Grid.Column="1" Grid.Row="8" Style="{StaticResource DefaultTextBlock}"
                       Text="{Binding NetAmount, StringFormat=\{0:N\}}"/>

            <Label Grid.Column="3" Grid.Row="0" Content="Student" Style="{StaticResource DefaultLabel}"/>
            <TextBlock Grid.Column="4" Grid.Row="0" Style="{StaticResource DefaultTextBlock}"
                       Text="{Binding Student.StudentFullName}"/>

            <Label Grid.Column="3" Grid.Row="1" Content="Section" Style="{StaticResource DefaultLabel}"/>
            <TextBlock Grid.Column="4" Grid.Row="1" Style="{StaticResource DefaultTextBlock}"
                       Text="{Binding Section}"/>

            <Label Grid.Column="3" Grid.Row="2" Content="Open Day / Time" Style="{StaticResource DefaultLabel}"/>
            <TextBlock Grid.Column="4" Grid.Row="2" Style="{StaticResource DefaultTextBlock}"
                       Text="{Binding Section.OpenDayStartEndTime}"/>

            <Label Grid.Column="3" Grid.Row="3" Content="Active" Style="{StaticResource DefaultLabel}"/>
            <TextBlock Grid.Column="4" Grid.Row="3" Style="{StaticResource DefaultTextBlock}"
                       Text="{Binding StudentSection.Active, Converter={StaticResource BooleanToYesNoConverter}}"/>

            <Label Grid.Column="3" Grid.Row="4" Content="Registered Date" Style="{StaticResource DefaultLabel}"/>
            <TextBlock Grid.Column="4" Grid.Row="4" Style="{StaticResource DefaultTextBlock}"
                       Text="{Binding StudentSection.RegisteredDate, StringFormat={StaticResource DatePattern}}"/>

            <Label Grid.Column="3" Grid.Row="5" Content="Resigned Date" Style="{StaticResource DefaultLabel}"/>
            <TextBlock Grid.Column="4" Grid.Row="5" Style="{StaticResource DefaultTextBlock}"
                        Text="{Binding StudentSection.ResignedDate, StringFormat={StaticResource DatePattern}}"/>

            <Label Grid.Column="3" Grid.Row="6" Content="Class" Style="{StaticResource DefaultLabel}"/>
            <TextBlock Grid.Column="4" Grid.Row="6" Style="{StaticResource DefaultTextBlock}"
                       Text="{Binding Class}"/>

            <Label Grid.Column="3" Grid.Row="7" Content="Course" Style="{StaticResource DefaultLabel}"/>
            <TextBlock Grid.Column="4" Grid.Row="7" Style="{StaticResource DefaultTextBlock}"
                       Text="{Binding Course}"/>

            <Label Grid.Column="3" Grid.Row="8" Content="Academic Year" Style="{StaticResource DefaultLabel}"/>
            <TextBlock Grid.Column="4" Grid.Row="8" Style="{StaticResource DefaultTextBlock}"
                       Text="{Binding AcademicYear}"/>

            <Label Grid.Column="3" Grid.Row="9" Content="School" Style="{StaticResource DefaultLabel}"/>
            <TextBlock Grid.Column="4" Grid.Row="9" Style="{StaticResource DefaultTextBlock}"
                       Text="{Binding School}"/>
        </Grid>
    </DockPanel>
</sui:SimpleWindow>
