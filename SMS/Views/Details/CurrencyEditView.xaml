<sui:SimpleWindow x:Class="CodeflexSystems.SMS.Views.CurrencyEditView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sui="http://codeflexsystems.com/SmartUI"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False"
        Title="{Binding ViewName}">
    <DockPanel Style="{StaticResource DefaultDockPanel}"
               FocusManager.FocusedElement="{Binding ElementName=CurrencyNameTextBox}">
        <StackPanel Style="{StaticResource DefaultStackPanelButtonBar}">
            <Button Name="OKButton" Style="{StaticResource DefaultOKButton}"/>
            <Button Name="CancelButton" Style="{StaticResource DefaultCancelButton}"/>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Label Grid.Column="0" Grid.Row="0" Content="Currency _Name" Style="{StaticResource DefaultLabel}"
                   Target="{Binding ElementName=CurrencyNameTextBox, Mode=OneWay}"/>
            <sui:AutoSelectTextBox Name="CurrencyNameTextBox" Grid.Column="1" Grid.Row="0" Style="{StaticResource DefaultAutoSelectTextBoxMW200}"
                                   Text="{Binding CurrencyName, NotifyOnValidationError=True, ValidatesOnExceptions=True}"
                                   IsReadOnly="{Binding IsReadOnly}"/>

            <Label Grid.Column="0" Grid.Row="1" Content="Currency _Code" Style="{StaticResource DefaultLabel}"
                   Target="{Binding ElementName=CurrencyCodeTextBox, Mode=OneWay}"/>
            <sui:AutoSelectTextBox Name="CurrencyCodeTextBox" Grid.Column="1" Grid.Row="1" Style="{StaticResource DefaultAutoSelectTextBoxMW200}"
                                   Text="{Binding CurrencyCode, NotifyOnValidationError=True, ValidatesOnExceptions=True}"
                                   IsReadOnly="{Binding IsReadOnly}"/>

            <Label Grid.Column="0" Grid.Row="2" Content="Currency _Symbol" Style="{StaticResource DefaultLabel}"
                   Target="{Binding ElementName=CurrencySymbolTextBox, Mode=OneWay}"/>
            <sui:AutoSelectTextBox Name="CurrencySymbolTextBox" Grid.Column="1" Grid.Row="2" Style="{StaticResource DefaultAutoSelectTextBoxMW200}"
                                   Text="{Binding CurrencySymbol, NotifyOnValidationError=True, ValidatesOnExceptions=True}"
                                   IsReadOnly="{Binding IsReadOnly}"/>

            <Label Grid.Column="0" Grid.Row="3" Content="Created Date" Style="{StaticResource DefaultLabel}"/>
            <TextBlock Name="cdtb" Grid.Column="1" Grid.Row="3" Style="{StaticResource DefaultTextBlock}" 
                       Text="{Binding CreatedDateLT, StringFormat={StaticResource DateTimePattern}}"
                       Visibility="{Binding Path=IsNew, Converter={StaticResource InverseBooleanToHiddenConverter}}"/>

            <Label Grid.Column="0" Grid.Row="4" Content="Created By" Style="{StaticResource DefaultLabel}"/>
            <TextBlock Grid.Column="1" Grid.Row="4" Style="{StaticResource DefaultTextBlock}" 
                       Text="{Binding CreatedBy}"
                       Visibility="{Binding Visibility, ElementName=cdtb}"/>

            <Label Grid.Column="0" Grid.Row="5" Content="Modified Date" Style="{StaticResource DefaultLabel}"/>
            <TextBlock Grid.Column="1" Grid.Row="5" Style="{StaticResource DefaultTextBlock}" 
                       Text="{Binding ModifiedDateLT, StringFormat={StaticResource DateTimePattern}}"
                       Visibility="{Binding Visibility, ElementName=cdtb}"/>

            <Label Grid.Column="0" Grid.Row="6" Content="Modified By" Style="{StaticResource DefaultLabel}"/>
            <TextBlock Grid.Column="1" Grid.Row="6" Style="{StaticResource DefaultTextBlock}" 
                       Text="{Binding ModifiedBy}"
                       Visibility="{Binding Visibility, ElementName=cdtb}"/>
        </Grid>
    </DockPanel>
</sui:SimpleWindow>
