<sui:SimpleWindow x:Class="CodeflexSystems.SMS.Views.SectionEditView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sui="http://codeflexsystems.com/SmartUI"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False"
        Title="{Binding ViewName}">
    <DockPanel Style="{StaticResource DefaultDockPanel}"
               FocusManager.FocusedElement="{Binding ElementName=SectionNameTextBox}">
        <StackPanel Style="{StaticResource DefaultStackPanelButtonBar}">
            <Button Name="OKButton" Style="{StaticResource DefaultOKButton}"/>
            <Button Name="CancelButton" Style="{StaticResource DefaultCancelButton}"/>
        </StackPanel>

        <Grid Grid.IsSharedSizeScope="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition SharedSizeGroup="TextBlockColumn"/>
                <ColumnDefinition Width="{StaticResource DefaultColumnGap}"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition SharedSizeGroup="TextBlockColumn"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Label Grid.Column="0" Grid.Row="0" Content="Section _Name" Style="{StaticResource DefaultLabel}"
                   Target="{Binding ElementName=SectionNameTextBox, Mode=OneWay}"/>
            <sui:AutoSelectTextBox Name="SectionNameTextBox" Grid.Column="1" Grid.Row="0" Style="{StaticResource DefaultAutoSelectTextBoxW200}"
                                   Text="{Binding SectionName, NotifyOnValidationError=True, ValidatesOnExceptions=True}"/>

            <Label Grid.Column="0" Grid.Row="1" Content="_Room" Style="{StaticResource DefaultLabel}"
                   Target="{Binding ElementName=RoomTextBox, Mode=OneWay}"/>
            <sui:AutoSelectTextBox Name="RoomTextBox" Grid.Column="1" Grid.Row="1" Style="{StaticResource DefaultAutoSelectTextBoxW200}"
                                   Text="{Binding Room, NotifyOnValidationError=True, ValidatesOnExceptions=True}"/>

            <Label Grid.Column="0" Grid.Row="2" Content="Open _Day" Style="{StaticResource DefaultLabel}"
                   Target="{Binding ElementName=OpenDayTextBox, Mode=OneWay}"/>
            <sui:AutoSelectTextBox Name="OpenDayTextBox" Grid.Column="1" Grid.Row="2" Style="{StaticResource DefaultAutoSelectTextBoxW200}"
                                   Text="{Binding OpenDay, NotifyOnValidationError=True, ValidatesOnExceptions=True}"/>

            <Label Grid.Column="0" Grid.Row="3" Content="_Start Time" Style="{StaticResource DefaultLabel}"
                   Target="{Binding ElementName=StartTimePicker, Mode=OneWay}"/>
            <sui:TimePicker Name="StartTimePicker" Grid.Column="1" Grid.Row="3" Style="{StaticResource DefaultTimePickerW200}"
                            Value="{Binding StartDateTime}"/>

            <Label Grid.Column="0" Grid.Row="4" Content="_End Time" Style="{StaticResource DefaultLabel}"
                   Target="{Binding ElementName=EndTimePicker, Mode=OneWay}"/>
            <sui:TimePicker Name="EndTimePicker" Grid.Column="1" Grid.Row="4" Style="{StaticResource DefaultTimePickerW200}"
                            Value="{Binding EndDateTime}"/>

            <Label Grid.Column="0" Grid.Row="5" Content="Com_mencing Date" Style="{StaticResource DefaultLabel}"
                   Target="{Binding ElementName=CommencingDatePicker, Mode=OneWay}"/>
            <sui:DateTimePicker Name="CommencingDatePicker" Grid.Column="1" Grid.Row="5" Style="{StaticResource DefaultDateTimePickerW200}"
                                Value="{Binding CommencingDate}"/>

            <Label Grid.Column="0" Grid.Row="6" Content="Com_pletion Date" Style="{StaticResource DefaultLabel}"
                   Target="{Binding ElementName=CompletionDatePicker, Mode=OneWay}"/>
            <sui:DateTimePicker Name="CompletionDatePicker" Grid.Column="1" Grid.Row="6" Style="{StaticResource DefaultDateTimePickerW200}"
                                Value="{Binding CompletionDate}"/>

            <Label Grid.Column="0" Grid.Row="7" Content="_Currency" Style="{StaticResource DefaultLabel}"
                   Target="{Binding ElementName=CurrencyComboBox, Mode=OneWay}"/>
            <ComboBox Name="CurrencyComboBox" Grid.Column="1" Grid.Row="7" Style="{StaticResource DefaultComboBoxW200}"
                      SelectedItem="{Binding Currency, Mode=TwoWay}" ItemsSource="{Binding Currencies}"/>

            <Label Grid.Column="0" Grid.Row="8" Content="_Fee" Style="{StaticResource DefaultLabel}"
                   Target="{Binding ElementName=FeeDecimalUpDown, Mode=OneWay}"/>
            <sui:DecimalUpDown Name="FeeDecimalUpDown" Grid.Column="1" Grid.Row="8" Style="{StaticResource DefaultDecimalUpDown}"
                               Value="{Binding Fee, NotifyOnValidationError=True, ValidatesOnExceptions=True}"
                               Minimum="0"/>

            <CheckBox Grid.Column="1" Grid.Row="9" IsChecked="{Binding Monthly}"
                      Content="Monthly" Style="{StaticResource DefaultCheckBox}"/>

            <Label Grid.Column="3" Grid.Row="0" Content="D_escription" Style="{StaticResource DefaultLabel}"
                   Target="{Binding ElementName=DescriptionTextBox, Mode=OneWay}"/>
            <sui:AutoSelectTextBox Name="DescriptionTextBox" Grid.Column="4" Grid.Row="0" Style="{StaticResource DefaultAutoSelectTextBoxW200}"
                                   Text="{Binding Description, NotifyOnValidationError=True, ValidatesOnExceptions=True}"
                                   Grid.RowSpan="2" TextWrapping="Wrap" Height="52" VerticalScrollBarVisibility="Auto"/>

            <Label Grid.Column="3" Grid.Row="2" Content="Class" Style="{StaticResource DefaultLabel}"/>
            <TextBlock Grid.Column="4" Grid.Row="2" Style="{StaticResource DefaultTextBlock}"
                       Text="{Binding Class}"/>

            <Label Grid.Column="3" Grid.Row="3" Content="Course" Style="{StaticResource DefaultLabel}"/>
            <TextBlock Grid.Column="4" Grid.Row="3" Style="{StaticResource DefaultTextBlock}"
                       Text="{Binding Course}"/>

            <Label Grid.Column="3" Grid.Row="4" Content="Academic Year" Style="{StaticResource DefaultLabel}"/>
            <TextBlock Grid.Column="4" Grid.Row="4" Style="{StaticResource DefaultTextBlock}"
                       Text="{Binding AcademicYear}"/>

            <Label Grid.Column="3" Grid.Row="5" Content="School" Style="{StaticResource DefaultLabel}"/>
            <TextBlock Grid.Column="4" Grid.Row="5" Style="{StaticResource DefaultTextBlock}"
                       Text="{Binding School}"/>

            <Label Grid.Column="3" Grid.Row="6" Content="Created Date" Style="{StaticResource DefaultLabel}"/>
            <TextBlock Name="cdtb" Grid.Column="6" Grid.Row="6" Style="{StaticResource DefaultTextBlock}" 
                       Text="{Binding CreatedDateLT, StringFormat={StaticResource DateTimePattern}}"
                       Visibility="{Binding Path=IsNew, Converter={StaticResource InverseBooleanToHiddenConverter}}"/>

            <Label Grid.Column="3" Grid.Row="7" Content="Created By" Style="{StaticResource DefaultLabel}"/>
            <TextBlock Grid.Column="4" Grid.Row="7" Style="{StaticResource DefaultTextBlock}" 
                       Text="{Binding CreatedBy}"
                       Visibility="{Binding Visibility, ElementName=cdtb}"/>

            <Label Grid.Column="3" Grid.Row="8" Content="Modified Date" Style="{StaticResource DefaultLabel}"/>
            <TextBlock Grid.Column="4" Grid.Row="8" Style="{StaticResource DefaultTextBlock}" 
                       Text="{Binding ModifiedDateLT, StringFormat={StaticResource DateTimePattern}}"
                       Visibility="{Binding Visibility, ElementName=cdtb}"/>

            <Label Grid.Column="3" Grid.Row="9" Content="Modified By" Style="{StaticResource DefaultLabel}"/>
            <TextBlock Grid.Column="4" Grid.Row="9" Style="{StaticResource DefaultTextBlock}" 
                       Text="{Binding ModifiedBy}"
                       Visibility="{Binding Visibility, ElementName=cdtb}"/>
        </Grid>
    </DockPanel>
</sui:SimpleWindow>
