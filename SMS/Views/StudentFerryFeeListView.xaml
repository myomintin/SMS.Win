<UserControl x:Class="CodeflexSystems.SMS.Views.StudentFerryFeeListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:sui="http://codeflexsystems.com/SmartUI"
             sui:ModernFrame.KeepAlive="False"
             mc:Ignorable="d" d:DesignHeight="300" d:DesignWidth="800">
    <UserControl.InputBindings>
        <KeyBinding Command="{Binding AddCommand}"
                    Gesture="Ctrl+N"/>
        <KeyBinding Command="{Binding EditCommand}"
                    Gesture="Ctrl+E"/>
        <KeyBinding Command="{Binding DeleteCommand}"
                    Key="Delete"/>
        <KeyBinding Command="{Binding RefreshCommand}"
                    Key="F5"/>
    </UserControl.InputBindings>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition MinWidth="210" Width="210"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Content="Sch_ool" Style="{StaticResource DefaultStackLabel}"
                   Target="{Binding ElementName=SchoolComboBox, Mode=OneWay}"/>
            <ComboBox Name="SchoolComboBox" Grid.Row="1" Style="{StaticResource DefaultComboBoxMW200}"
                      SelectedItem="{Binding Schools.SelectedItem, Mode=TwoWay}"
                      ItemsSource="{Binding Schools}"/>

            <Label Grid.Row="2" Content="Academic _Year" Style="{StaticResource DefaultStackLabel}"
                   Target="{Binding ElementName=AcademicYearComboBox, Mode=OneWay}"/>
            <ComboBox Name="AcademicYearComboBox" Grid.Row="3" Style="{StaticResource DefaultComboBoxMW200}"
        		      SelectedItem="{Binding AcademicYears.SelectedItem, Mode=TwoWay}"
                      ItemsSource="{Binding AcademicYears}"/>

            <Label Grid.Row="4" Content="Cou_rse" Style="{StaticResource DefaultStackLabel}"
                   Target="{Binding ElementName=CourseComboBox, Mode=OneWay}"/>
            <ComboBox Name="CourseComboBox" Grid.Row="5" Style="{StaticResource DefaultComboBoxMW200}"
        		      SelectedItem="{Binding Courses.SelectedItem, Mode=TwoWay}"
                      ItemsSource="{Binding Courses}"/>
        </Grid>

        <GridSplitter Grid.Column="1" Style="{StaticResource DefaultGridSplitter}"/>

        <Grid Grid.Column="2" Margin="20,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{Binding ViewName}" Style="{StaticResource DefaultTitle}"/>

            <WrapPanel Grid.Row="1" Style="{StaticResource DefaultWarpPanelButtonBar}">
                <Button Content="_Add" Command="{Binding AddCommand}"
                        Style="{StaticResource DefaultLeftButton}"/>
                <Button Name="EditButton" Content="_Edit" Command="{Binding EditCommand}"
                        Style="{StaticResource DefaultButton}"/>
                <Button Content="{Binding DeleteContent}" Command="{Binding DeleteCommand}"
                        Style="{StaticResource DefaultButton}"/>
                <Button Content="_Refresh" Command="{Binding RefreshCommand}"
                        Style="{StaticResource DefaultRightButton}"/>
            </WrapPanel>

            <DataGrid Name="ListDataGrid" Grid.Row="2" Style="{StaticResource DefaultDataGrid}"
                      SelectedItem="{Binding Collection.SelectedItem, Mode=TwoWay}"
                      ItemsSource="{Binding Collection}"
                      MouseDoubleClick="ListDataGrid_MouseDoubleClick"
                      SelectionChanged="ListDataGrid_SelectionChanged">
                <DataGrid.Columns>
                    <sui:DataGridTextColumn Header="Id" Binding="{Binding Student.Id}"/>
                    <sui:DataGridTextColumn Header="Student Name" Binding="{Binding Student.StudentFullName}"/>
                    <sui:DataGridTextColumn Header="Section" Binding="{Binding Section}"/>
                    <sui:DataGridTextColumn Header="Fee" Binding="{Binding Fee, StringFormat=\{0:N\}}"
                                            ElementAlignment="Right" HeaderAlignment="Right"/>
                    <sui:DataGridCheckBoxColumn Header="Monthly" Binding="{Binding Monthly}"/>
                    <sui:DataGridTextColumn Header="Created Date" Binding="{Binding CreatedDateLT, Mode=OneWay, StringFormat={StaticResource DateTimePattern}}"/>
                    <sui:DataGridTextColumn Header="Modified Date" Binding="{Binding ModifiedDateLT, Mode=OneWay, StringFormat={StaticResource DateTimePattern}}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
