<UserControl x:Class="CodeflexSystems.SMS.Views.UserListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:sui="http://codeflexsystems.com/SmartUI"
             sui:ModernFrame.KeepAlive="False"
             mc:Ignorable="d" d:DesignHeight="300" d:DesignWidth="600">
    <UserControl.InputBindings>
        <KeyBinding Command="{Binding AddCommand}"
                    Gesture="Ctrl+N"/>
        <KeyBinding Command="{Binding EditCommand}"
                    Gesture="Ctrl+E"/>
        <KeyBinding Command="{Binding DeleteCommand}"
                    Gesture="Ctrl+M"/>
        <KeyBinding Command="{Binding RefreshCommand}"
                    Key="F5"/>
        <KeyBinding Command="{Binding SaveCommand}"
                    Gesture="Ctrl+W"/>
    </UserControl.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding ViewName}" Style="{StaticResource DefaultTitle}"/>

        <WrapPanel Grid.Row="1" Style="{StaticResource DefaultWarpPanelButtonBar}">
            <Button Content="_Add" Command="{Binding AddCommand}"
                    Style="{StaticResource DefaultLeftButton}"/>
            <Button Name="EditButton" Content="_Edit" Command="{Binding EditCommand}"
                    Style="{StaticResource DefaultButton}"/>
            <Button Content="Per_missions" Command="{Binding DeleteCommand}"
                    Style="{StaticResource DefaultButton}"
                    CommandParameter="{Binding RelativeSource={x:Static RelativeSource.Self}}"/>
            <Button Content="Reset Pass_word" Command="{Binding SaveCommand}"
                    Style="{StaticResource DefaultButton}"
                    CommandParameter="{Binding RelativeSource={x:Static RelativeSource.Self}}"/>
            <Button Content="_Refresh" Command="{Binding RefreshCommand}"
                    Style="{StaticResource DefaultRightButton}"/>
        </WrapPanel>

        <DataGrid Name="ListDataGrid" Grid.Row="2" Style="{StaticResource DefaultDataGrid}"
                  SelectedItem="{Binding Paging.SelectedItem, Mode=TwoWay}"
                  ItemsSource="{Binding Collection}"
                  MouseDoubleClick="ListDataGrid_MouseDoubleClick"
                  SelectionChanged="ListDataGrid_SelectionChanged">
            <DataGrid.Columns>
                <sui:DataGridTextColumn Header="User Name" Binding="{Binding UserName}"/>
                <sui:DataGridTextColumn Header="Full Name" Binding="{Binding FullName}"/>
                <sui:DataGridTextColumn Header="Disabled" Binding="{Binding Disabled}"/>
                <sui:DataGridTextColumn Header="Created Date" Binding="{Binding CreatedDateLT, Mode=OneWay, StringFormat={StaticResource DateTimePattern}}"/>
                <sui:DataGridTextColumn Header="Modified Date" Binding="{Binding ModifiedDateLT, Mode=OneWay, StringFormat={StaticResource DateTimePattern}}"/>
            </DataGrid.Columns>
        </DataGrid>
        
        <sui:PagingNavigator Grid.Row="3" Page="{Binding Paging.Page, Mode=TwoWay}" TotalPages="{Binding Paging.TotalPages}" Margin="0,5,0,0"/>
    </Grid>
</UserControl>
