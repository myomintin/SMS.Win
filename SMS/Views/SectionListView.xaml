<UserControl x:Class="CodeflexSystems.SMS.Views.SectionListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:sui="http://codeflexsystems.com/SmartUI"
             sui:ModernFrame.KeepAlive="False"
             mc:Ignorable="d" d:DesignHeight="300" d:DesignWidth="600">
    <UserControl.InputBindings>
        <KeyBinding Command="{Binding AddCommand}"
                    Gesture="Ctrl+N"/>
        <KeyBinding Command="{Binding EditCommand}"
                    Gesture="Ctrl+E"/>
        <KeyBinding Command="{Binding DeleteCommand}"
                    Key="Delete"/>
        <KeyBinding Command="{Binding RefreshCommand}"
                    Key="F5"/>
        <KeyBinding Command="{Binding SaveCommand}"
                    Gesture="Ctrl+S"/>
    </UserControl.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding ViewName}" Style="{StaticResource DefaultTitle}"/>

        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Label Grid.Column="0" Grid.Row="0" Content="Sch_ool" Style="{StaticResource DefaultLabel}"
                   Target="{Binding ElementName=SchoolComboBox, Mode=OneWay}"/>
            <ComboBox Name="SchoolComboBox" Grid.Column="1" Grid.Row="0" Style="{StaticResource DefaultComboBoxW200}"
        		      SelectedItem="{Binding Schools.SelectedItem, Mode=TwoWay}"
                      ItemsSource="{Binding Schools}"/>

            <Label Grid.Column="0" Grid.Row="1" Content="Academic _Year" Style="{StaticResource DefaultLabel}"
                   Target="{Binding ElementName=AcademicYearComboBox, Mode=OneWay}"/>
            <ComboBox Name="AcademicYearComboBox" Grid.Column="1" Grid.Row="1" Style="{StaticResource DefaultComboBoxW200}"
        		      SelectedItem="{Binding AcademicYears.SelectedItem, Mode=TwoWay}"
                      ItemsSource="{Binding AcademicYears}"/>

            <Label Grid.Column="0" Grid.Row="2" Content="Cou_rse" Style="{StaticResource DefaultLabel}"
                   Target="{Binding ElementName=CourseComboBox, Mode=OneWay}"/>
            <ComboBox Name="CourseComboBox" Grid.Column="1" Grid.Row="2" Style="{StaticResource DefaultComboBoxW200}"
        		      SelectedItem="{Binding Courses.SelectedItem, Mode=TwoWay}"
                      ItemsSource="{Binding Courses}"/>
            
            <Label Grid.Column="0" Grid.Row="3" Content="_Class" Style="{StaticResource DefaultLabel}"
                   Target="{Binding ElementName=ClassComboBox, Mode=OneWay}"/>
            <ComboBox Name="ClassComboBox" Grid.Column="1" Grid.Row="3" Style="{StaticResource DefaultComboBoxW200}"
        		      SelectedItem="{Binding Classes.SelectedItem, Mode=TwoWay}"
                      ItemsSource="{Binding Classes}"/>
        </Grid>

        <WrapPanel Grid.Row="2" Style="{StaticResource DefaultWarpPanelButtonBar}">
            <Button Content="_Add" Command="{Binding AddCommand}"
                    Style="{StaticResource DefaultLeftButton}"/>
            <Button Name="EditButton" Content="_Edit" Command="{Binding EditCommand}"
                    Style="{StaticResource DefaultButton}"/>
            <Button Content="{Binding DeleteContent}" Command="{Binding DeleteCommand}"
                    Style="{StaticResource DefaultButton}"/>
            <Button Content="_Refresh" Command="{Binding RefreshCommand}"
                    Style="{StaticResource DefaultButton}"/>
            <Button Content="_Save" Command="{Binding SaveCommand}"
                    Style="{StaticResource DefaultRightButton}"/>
        </WrapPanel>

        <DataGrid Name="ListDataGrid" Grid.Row="3" Style="{StaticResource DefaultDataGrid}"
                  SelectedItem="{Binding Collection.SelectedItem, Mode=TwoWay}"
                  ItemsSource="{Binding Collection}"
                  MouseDoubleClick="ListDataGrid_MouseDoubleClick"
                  SelectionChanged="ListDataGrid_SelectionChanged">
            <DataGrid.Columns>
                <sui:DataGridTextColumn Header="Section" Binding="{Binding SectionName}"/>
                <sui:DataGridTextColumn Header="Room" Binding="{Binding Room}"/>
                <sui:DataGridTextColumn Header="Open Day" Binding="{Binding OpenDay}"/>
                <sui:DataGridTextColumn Header="Start Time" Binding="{Binding StartDateTime, StringFormat={StaticResource TimePattern}}"/>
                <sui:DataGridTextColumn Header="End Time" Binding="{Binding EndDateTime, StringFormat={StaticResource TimePattern}}"/>
                <sui:DataGridTextColumn Header="Commencing" Binding="{Binding CommencingDate, StringFormat={StaticResource DatePattern}}"/>
                <sui:DataGridTextColumn Header="Completion" Binding="{Binding CompletionDate, StringFormat={StaticResource DatePattern}}"/>
                <sui:DataGridTextColumn Header="Created Date" Binding="{Binding CreatedDateLT, Mode=OneWay, StringFormat={StaticResource DateTimePattern}}"/>
                <sui:DataGridTextColumn Header="Modified Date" Binding="{Binding ModifiedDateLT, Mode=OneWay, StringFormat={StaticResource DateTimePattern}}"/>
                <sui:DataGridTextColumn Header="Overall State" Binding="{Binding OverallState}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
