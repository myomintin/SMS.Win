<UserControl x:Class="CodeflexSystems.SMS.Views.UserOptionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:sui="http://codeflexsystems.com/SmartUI"
             sui:ModernFrame.KeepAlive="False"
             mc:Ignorable="d" d:DesignHeight="500" d:DesignWidth="700">
    <UserControl.InputBindings>
        <KeyBinding Command="{Binding SaveCommand}"
                    Gesture="Ctrl+S"/>
        <KeyBinding Command="{Binding ResetCommand}"
                    Gesture="Ctrl+R"/>
    </UserControl.InputBindings>
    <Grid>
        <ScrollViewer>
            <StackPanel x:Name="Panel" MinWidth="400">
                <TextBlock Text="{Binding ViewName}" Style="{StaticResource DefaultTitle}"/>

                <ListBox ItemsSource="{Binding AccentColors}"
                         SelectedItem="{Binding AccentColor, Mode=TwoWay}"
                         Margin="0,0,0,10">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel MaxWidth="{Binding ActualWidth, ElementName=Panel}" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Rectangle Width="40" Height="40" Margin="2" >
                                <Rectangle.Fill>
                                    <SolidColorBrush x:Name="Brush" Color="{Binding}" />
                                </Rectangle.Fill>
                            </Rectangle>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="{StaticResource DefaultColumnGap}"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Content="Theme" Style="{StaticResource DefaultLabel}"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" Style="{StaticResource DefaultComboBoxW200}"
                              ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme, Mode=TwoWay}" DisplayMemberPath="DisplayName"/>

                    <Label Grid.Row="1" Content="Font Size" Style="{StaticResource DefaultLabel}"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" Style="{StaticResource DefaultComboBoxW200}"
                              ItemsSource="{Binding FontSizes}" SelectedItem="{Binding FontSize, Mode=TwoWay}"/>

                    <Label Grid.Row="2" Content="Page Size" Style="{StaticResource DefaultLabel}"/>
                    <sui:IntegerUpDown Grid.Row="2" Grid.Column="1" Style="{StaticResource DefaultIntegerUpDown}"
                            Value="{Binding PageSize}" Minimum="10" Maximum="50" Width="100" HorizontalAlignment="Left"/>

                    <Label Grid.Row="3" Content="Date Pattern" Style="{StaticResource DefaultLabel}"/>
                    <ComboBox Grid.Row="3" Grid.Column="1" Style="{StaticResource DefaultComboBoxMW200}"
                              ItemsSource="{Binding DatePatterns}" SelectedItem="{Binding DatePattern, Mode=TwoWay}"/>

                    <sui:DateTimePicker x:Name="DatePatternDTP" Grid.Row="3" Grid.Column="3" Style="{StaticResource DefaultDateTimePickerMW200}"
                                        FormatString="{Binding DatePattern}" FirstDayOfWeek="{Binding FirstDayOfWeek}"/>

                    <Label Grid.Row="4" Content="Time Pattern" Style="{StaticResource DefaultLabel}"/>
                    <ComboBox Grid.Row="4" Grid.Column="1" Style="{StaticResource DefaultComboBoxMW200}"
                              ItemsSource="{Binding TimePatterns}" SelectedItem="{Binding TimePattern, Mode=TwoWay}"/>

                    <sui:TimePicker x:Name="TimePatternTP" Grid.Row="4" Grid.Column="3" Style="{StaticResource DefaultTimePickerMW200}"
                                    FormatString="{Binding TimePattern}"/>

                    <Label Grid.Row="5" Content="Date Time Pattern" Style="{StaticResource DefaultLabel}"/>
                    <ComboBox Grid.Row="5" Grid.Column="1" Style="{StaticResource DefaultComboBoxMW200}"
                              ItemsSource="{Binding DateTimePatterns}"
                              SelectedItem="{Binding DateTimePatterns.SelectedItem, Mode=TwoWay}"/>

                    <sui:DateTimePicker x:Name="DateTimePatternDTP" Grid.Row="5" Grid.Column="3" Style="{StaticResource DefaultDateTimePickerMW200}"
                                        FormatString="{Binding DateTimePattern}" FirstDayOfWeek="{Binding FirstDayOfWeek}"
                                        TimePickerVisibility="Visible"/>

                    <Label Grid.Row="6" Content="First Day of Week" Style="{StaticResource DefaultLabel}"/>
                    <ComboBox Grid.Row="6" Grid.Column="1" Style="{StaticResource DefaultComboBoxMW200}"
                              ItemsSource="{Binding FirstDayOfWeeks}" SelectedItem="{Binding FirstDayOfWeek, Mode=TwoWay}"/>

                    <Label Grid.Row="7" Content="Currency Positive" Style="{StaticResource DefaultLabel}"/>
                    <ComboBox Grid.Row="7" Grid.Column="1" Style="{StaticResource DefaultComboBoxW200}"
                              ItemsSource="{Binding CurrencyPositivePatterns}"
                              SelectedItem="{Binding CurrencyPositivePatterns.SelectedItem, Mode=TwoWay}"/>

                    <sui:AutoSelectTextBox Name="CurrencyPositivePatternTextBox" Grid.Row="7" Grid.Column="3"
                            Style="{StaticResource DefaultAutoSelectTextBoxMW200}"/>

                    <Label Grid.Row="8" Content="Currency Negative" Style="{StaticResource DefaultLabel}"/>
                    <ComboBox Grid.Row="8" Grid.Column="1" Style="{StaticResource DefaultComboBoxW200}"
                              ItemsSource="{Binding CurrencyNegativePatterns}"
                              SelectedItem="{Binding CurrencyNegativePatterns.SelectedItem, Mode=TwoWay}"/>

                    <sui:AutoSelectTextBox Name="CurrencyNegativePatternTextBox" Grid.Row="8" Grid.Column="3"
                            Style="{StaticResource DefaultAutoSelectTextBoxMW200}"/>

                    <Label Grid.Row="9" Content="Transition Effect" Style="{StaticResource DefaultLabel}"/>
                    <ComboBox Grid.Row="9" Grid.Column="1" Style="{StaticResource DefaultComboBoxW200}"
                              ItemsSource="{Binding TransitionEffects}" SelectedItem="{Binding TransitionEffect, Mode=TwoWay}"
                              SelectionChanged="TransitionEffectsComboBox_SelectionChanged"/>

                    <StackPanel Grid.Row="10" Grid.Column="1" Margin="0,5,0,0" HorizontalAlignment="Left" Orientation="Horizontal">
                        <Button Content="_Save" Style="{StaticResource DefaultLeftButton}" Command="{Binding SaveCommand}"/>
                        <Button Content="_Reset" Style="{StaticResource DefaultRightButton}" Command="{Binding ResetCommand}"/>
                    </StackPanel>
                </Grid>

                <sui:TransitioningContentControl Name="TransitionEffectContentControl" Margin="0,10,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
