<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sui="http://codeflexsystems.com/SmartUI"
                    xmlns:controls="clr-namespace:CodeflexSystems.SMS.Controls">

    <Style TargetType="controls:ImageViewer">
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="MinHeight" Value="110"/>
        <Setter Property="MinWidth" Value="140"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:ImageViewer">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="5"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Image x:Name="PART_ThumbnailImage" Margin="2"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="2,4,0,2" 
                                    HorizontalAlignment="Left">
                            <StackPanel.Resources>
                                <Style TargetType="sui:ModernButton">
                                    <Setter Property="EllipseDiameter" Value="24"/>
                                    <Setter Property="IconHeight" Value="14"/>
                                    <Setter Property="IconWidth" Value="14"/>
                                </Style>
                            </StackPanel.Resources>

                            <sui:ModernButton x:Name="PART_ChangeImageButton" IconData="{DynamicResource PlusIconData}"
                                              ToolTip="Change image from the file."/>
                            <sui:ModernButton x:Name="PART_ResetImageButton" IconData="{DynamicResource MinusIconData}"
                                              ToolTip="Reset image."/>
                            <sui:ModernButton x:Name="PART_ViewImageButton" IconData="{DynamicResource ExpandIconData}"
                                              ToolTip="View image to enlarge."/>
                            <sui:ModernButton x:Name="PART_SaveImageButton" IconData="{DynamicResource SaveIconData}"
                                              ToolTip="Save image to the file."/>
                        </StackPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

