            <StackPanel>
                <TextBlock TextWrapping="Wrap">
                    <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource StringConcatConverter}" ConverterParameter=", ">
                            <Binding Path="Student.Id"/>
