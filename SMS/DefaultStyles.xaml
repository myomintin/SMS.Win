                <AdornedElementPlaceholder Margin="-1"/>
            </Border>
            <Image Source="/Resources/error.image.png" Width="20" Height="20"
			       Margin="2,1,0,0" VerticalAlignment="Top"
			       ToolTip="{Binding Path=AdornedElement.ToolTip, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Adorner}}}"/>
        </StackPanel>
    </ControlTemplate>

