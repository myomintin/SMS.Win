                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Text="{Binding Section.SectionNameWithOpenDayStartEndTime}"/>
                <TextBlock TextWrapping="Wrap">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0}, {1}, {2}, {3}">
                            <Binding Path="Class"/>
                            <Binding Path="Course"/>
                            <Binding Path="AcademicYear"/>
                            <Binding Path="School"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </StackPanel>
        </Border>
    </DataTemplate>

