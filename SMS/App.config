<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="MinRequiredSearchWordLength" value="2" />
    <add key="MaxUsageCountToRefresh" value="40" />
    <add key="MaxImageFileSize" value="204800" />
    <add key="MaxLogFileSize" value="102400" />
    <add key="ShowAllErrors" value="True" />
    <add key="ReverseErrors" value="True" />
    <add key="WriteToLog" value="True" />
    <add key="CheckTimeZone" value="True" />
    <add key="TimeZone" value="06:30:00" />
    <add key="CheckDateTime" value="True" />
    <add key="CurrencyCode" value="MMK" />
    <add key="CountryCode" value="MM" />
  </appSettings>
  <connectionStrings>
    <add name="SMSContext" connectionString="Data Source=.;Initial Catalog=SMS;Integrated Security=True;MultipleActiveResultSets=True" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <startup useLegacyV2RuntimeActivationPolicy="True">
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5" />
  </startup>
  <system.diagnostics>
    <trace autoflush="true">
      <listeners>
        <clear />
        <add name="textListener" type="System.Diagnostics.TextWriterTraceListener" initializeData="Logs\SMSErrorLog.txt" />
      </listeners>
    </trace>
  </system.diagnostics>
</configuration>